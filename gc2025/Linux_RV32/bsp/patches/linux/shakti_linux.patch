diff --git a/drivers/tty/serial/shakti_uart.c b/drivers/tty/serial/shakti_uart.c
new file mode 100644
index 000000000000..7e8774818f7f
--- /dev/null
+++ b/drivers/tty/serial/shakti_uart.c
@@ -0,0 +1,940 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Shakti UART driver (FPGA validation build)
+ *
+ * - Console + tty driver for the Shakti SoC UART used on Nexys Video / Yamuna
+ * - EARLYCON support that avoids 32-bit reads of 16-bit regs
+ * - Known HW bug: writing CONTROL (0x14) crashes HW. All CONTROL writes are NOPs.
+ *
+ * Based on the SiFive UART driver.
+ */
+
+#include <linux/clk.h>
+#include <linux/console.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_irq.h>
+#include <linux/platform_device.h>
+#include <linux/serial_core.h>
+#include <linux/serial_reg.h>
+#include <linux/slab.h>
+#include <linux/tty.h>
+#include <linux/tty_flip.h>
+#include <linux/ctype.h>
+
+/* ---------- Driver options / debug ---------- */
+#define PORT_SHAKTI             123
+#define DEBUG_SHAKTI_UART       0
+
+#if DEBUG_SHAKTI_UART
+# define DBG(fmt, ...)          pr_info("shakti-uart: " fmt, ##__VA_ARGS__)
+# define DBG_ENTER()            pr_info("shakti-uart: ENTER %s\n", __func__)
+# define DBG_EXIT()             pr_info("shakti-uart: EXIT  %s\n", __func__)
+#else
+# define DBG(fmt, ...)          do { } while (0)
+# define DBG_ENTER()            do { } while (0)
+# define DBG_EXIT()             do { } while (0)
+#endif
+
+/* ---------- Register map (from Shakti SoC docs) ---------- */
+#define SHAKTI_UART_BAUD_OFFS           0x00    /* 16-bit */
+#define SHAKTI_UART_TX_REG_OFFS         0x04    /* 32-bit WO */
+#define SHAKTI_UART_RCV_REG_OFFS        0x08    /* 32-bit RO */
+#define SHAKTI_UART_STATUS_OFFS         0x0C    /* 16-bit RO */
+#define SHAKTI_UART_DELAY_OFFS          0x10    /* 16-bit RW */
+#define SHAKTI_UART_CONTROL_OFFS        0x14    /* 16-bit RW (BROKEN!) */
+#define SHAKTI_UART_IEN_OFFS            0x18    /* 16-bit RW */
+#define SHAKTI_UART_IQCYCLES_OFFS       0x1C    /* 8-bit  RW */
+#define SHAKTI_UART_RX_THRESHOLD_OFFS   0x20    /* 8-bit  RW */
+
+/* Status bits */
+#define SHAKTI_UART_STATUS_TX_EMPTY_SHIFT       0
+#define SHAKTI_UART_STATUS_TX_EMPTY_MASK        (1 << SHAKTI_UART_STATUS_TX_EMPTY_SHIFT)
+#define SHAKTI_UART_STATUS_TX_NOT_FULL_SHIFT    1
+#define SHAKTI_UART_STATUS_TX_NOT_FULL_MASK     (1 << SHAKTI_UART_STATUS_TX_NOT_FULL_SHIFT)
+#define SHAKTI_UART_STATUS_TX_FULL_SHIFT        1
+#define SHAKTI_UART_STATUS_TX_FULL_MASK         (1 << SHAKTI_UART_STATUS_TX_FULL_SHIFT)
+#define SHAKTI_UART_STATUS_RX_NOT_EMPTY_SHIFT   2
+#define SHAKTI_UART_STATUS_RX_NOT_EMPTY_MASK    (1 << SHAKTI_UART_STATUS_RX_NOT_EMPTY_SHIFT)
+#define SHAKTI_UART_STATUS_RX_FULL_SHIFT        3
+#define SHAKTI_UART_STATUS_RX_FULL_MASK         (1 << SHAKTI_UART_STATUS_RX_FULL_SHIFT)
+#define SHAKTI_UART_STATUS_PARITY_ERROR_SHIFT   4
+#define SHAKTI_UART_STATUS_PARITY_ERROR_MASK    (1 << SHAKTI_UART_STATUS_PARITY_ERROR_SHIFT)
+#define SHAKTI_UART_STATUS_OVERRUN_ERROR_SHIFT  5
+#define SHAKTI_UART_STATUS_OVERRUN_ERROR_MASK   (1 << SHAKTI_UART_STATUS_OVERRUN_ERROR_SHIFT)
+#define SHAKTI_UART_STATUS_FRAME_ERROR_SHIFT    6
+#define SHAKTI_UART_STATUS_FRAME_ERROR_MASK     (1 << SHAKTI_UART_STATUS_FRAME_ERROR_SHIFT)
+#define SHAKTI_UART_STATUS_BREAK_ERROR_SHIFT    7
+#define SHAKTI_UART_STATUS_BREAK_ERROR_MASK     (1 << SHAKTI_UART_STATUS_BREAK_ERROR_SHIFT)
+#define SHAKTI_UART_STATUS_RXFIFOTH_SHIFT       8
+#define SHAKTI_UART_STATUS_RXFIFOTH_MASK        (1 << SHAKTI_UART_STATUS_RXFIFOTH_SHIFT)
+
+/* CONTROL fields (do NOT write in HW) */
+#define SHAKTI_UART_CONTROL_STOP_BITS_SHIFT     1
+#define SHAKTI_UART_CONTROL_STOP_BITS_MASK      (0x3 << SHAKTI_UART_CONTROL_STOP_BITS_SHIFT)
+#define SHAKTI_UART_CONTROL_PARITY_SHIFT        3
+#define SHAKTI_UART_CONTROL_PARITY_MASK         (0x3 << SHAKTI_UART_CONTROL_PARITY_SHIFT)
+#define SHAKTI_UART_CONTROL_CHAR_SIZE_SHIFT     5
+#define SHAKTI_UART_CONTROL_CHAR_SIZE_MASK      (0x3f << SHAKTI_UART_CONTROL_CHAR_SIZE_SHIFT)
+
+/* IEN bits */
+#define SHAKTI_UART_IEN_TX_EMPTY_SHIFT          0
+#define SHAKTI_UART_IEN_TX_EMPTY_MASK           (1 << SHAKTI_UART_IEN_TX_EMPTY_SHIFT)
+#define SHAKTI_UART_IEN_TX_FULL_SHIFT           1
+#define SHAKTI_UART_IEN_TX_FULL_MASK            (1 << SHAKTI_UART_IEN_TX_FULL_SHIFT)
+#define SHAKTI_UART_IEN_RX_NOT_EMPTY_SHIFT      2
+#define SHAKTI_UART_IEN_RX_NOT_EMPTY_MASK       (1 << SHAKTI_UART_IEN_RX_NOT_EMPTY_SHIFT)
+#define SHAKTI_UART_IEN_RX_FULL_SHIFT           3
+#define SHAKTI_UART_IEN_RX_FULL_MASK            (1 << SHAKTI_UART_IEN_RX_FULL_SHIFT)
+#define SHAKTI_UART_IEN_PARITY_ERROR_SHIFT      4
+#define SHAKTI_UART_IEN_PARITY_ERROR_MASK       (1 << SHAKTI_UART_IEN_PARITY_ERROR_SHIFT)
+#define SHAKTI_UART_IEN_OVERRUN_ERROR_SHIFT     5
+#define SHAKTI_UART_IEN_OVERRUN_ERROR_MASK      (1 << SHAKTI_UART_IEN_OVERRUN_ERROR_SHIFT)
+#define SHAKTI_UART_IEN_FRAME_ERROR_SHIFT       6
+#define SHAKTI_UART_IEN_FRAME_ERROR_MASK        (1 << SHAKTI_UART_IEN_FRAME_ERROR_SHIFT)
+#define SHAKTI_UART_IEN_BREAK_ERROR_SHIFT       7
+#define SHAKTI_UART_IEN_BREAK_ERROR_MASK        (1 << SHAKTI_UART_IEN_BREAK_ERROR_SHIFT)
+#define SHAKTI_UART_IEN_RXFIFOTH_SHIFT          8
+#define SHAKTI_UART_IEN_RXFIFOTH_MASK           (1 << SHAKTI_UART_IEN_RXFIFOTH_SHIFT)
+
+/* ---------- Driver config ---------- */
+#define SHAKTI_SERIAL_MAX_PORTS  3
+#define SHAKTI_DEFAULT_BAUD_RATE 115200
+#define SHAKTI_SERIAL_NAME       "shakti-serial"
+#define SHAKTI_TTY_PREFIX        "ttySHK"
+#define SHAKTI_TX_FIFO_DEPTH     16
+#define SHAKTI_RX_FIFO_DEPTH     16
+
+/* ---------- Data structures ---------- */
+struct shakti_serial_port {
+	struct uart_port	port;
+	struct device		*dev;
+	u16			ier;
+	unsigned int		baud_rate;
+	struct clk		*clk;
+	struct notifier_block	clk_notifier;
+	bool			console_line_ended;
+	bool			polling_mode;	/* Force polling mode if IRQ fails */
+};
+
+#define port_to_shakti_serial_port(p) container_of((p), struct shakti_serial_port, port)
+#define notifier_to_shakti_serial_port(nb) container_of((nb), struct shakti_serial_port, clk_notifier)
+
+/* ---------- Low-level MMIO helpers ---------- */
+static void __ssp_early_writel(u32 v, u16 offs, struct uart_port *port)
+{
+	writel_relaxed(v, port->membase + offs);
+}
+
+static u32 __ssp_early_readl(struct uart_port *port, u16 offs)
+{
+	u32 value = readl_relaxed(port->membase + offs);
+	return value;
+}
+
+/* 16-bit safe helpers for regs that are 16-bit wide */
+static inline u16 __ssp_early_readw(struct uart_port *port, u16 offs)
+{
+	u16 v = readw_relaxed(port->membase + offs);
+	return v;
+}
+
+static inline void __ssp_early_writew(u16 v, u16 offs, struct uart_port *port)
+{
+	writew_relaxed(v, port->membase + offs);
+}
+
+static void __ssp_writel(u32 v, u16 offs, struct shakti_serial_port *ssp)
+{
+	__ssp_early_writel(v, offs, &ssp->port);
+}
+
+static inline u32 __ssp_readl(struct shakti_serial_port *ssp, u16 offs)
+{
+	return __ssp_early_readl(&ssp->port, offs);
+}
+
+static void __ssp_write_ier(struct shakti_serial_port *ssp, u16 val)
+{
+	writew_relaxed(val, ssp->port.membase + SHAKTI_UART_IEN_OFFS);
+}
+
+static u16 __ssp_read_ier(struct shakti_serial_port *ssp)
+{
+	u16 value = readw_relaxed(ssp->port.membase + SHAKTI_UART_IEN_OFFS);
+	return value;
+}
+
+static void __ssp_write_ctrl(struct shakti_serial_port *ssp, u16 val)
+{
+	/* CONTROL write is blocked due to HW bug */
+}
+
+static u16 __ssp_read_ctrl(struct shakti_serial_port *ssp)
+{
+	u16 value = readw_relaxed(ssp->port.membase + SHAKTI_UART_CONTROL_OFFS);
+	return value;
+}
+
+static u16 __ssp_read_status(struct shakti_serial_port *ssp)
+{
+	u16 value = readw_relaxed(ssp->port.membase + SHAKTI_UART_STATUS_OFFS);
+	return value;
+}
+
+/* ---------- Helpers ---------- */
+static int shakti_serial_is_txfifo_full(struct shakti_serial_port *ssp)
+{
+	u16 status = __ssp_read_status(ssp);
+	return status & SHAKTI_UART_STATUS_TX_FULL_MASK;
+}
+
+static void __ssp_transmit_char(struct shakti_serial_port *ssp, int ch)
+{
+	__ssp_writel(ch, SHAKTI_UART_TX_REG_OFFS, ssp);
+}
+
+static void __ssp_transmit_chars(struct shakti_serial_port *ssp)
+{
+	u8 ch;
+	int written = 0;
+
+	DBG_ENTER();
+	uart_port_tx_limited(&ssp->port, ch, SHAKTI_TX_FIFO_DEPTH,
+			     true,
+			     __ssp_transmit_char(ssp, ch),
+			     ({ written++; }));
+	DBG_EXIT();
+}
+
+static void __maybe_unused __ssp_wait_for_xmitr(struct shakti_serial_port *ssp)
+{
+	int i = 0;
+
+	DBG_ENTER();
+	while (shakti_serial_is_txfifo_full(ssp)) {
+		udelay(1);
+		if (++i > 100000) {
+			pr_err("shakti-uart: TX wait timeout\n");
+			break;
+		}
+	}
+	DBG_EXIT();
+}
+
+/* ---------- Serial core ops ---------- */
+static void shakti_serial_stop_tx(struct uart_port *port)
+{
+	struct shakti_serial_port *ssp = port_to_shakti_serial_port(port);
+
+	DBG_ENTER();
+	if (!ssp->polling_mode) {
+		ssp->ier &= ~SHAKTI_UART_IEN_TX_EMPTY_MASK;
+		__ssp_write_ier(ssp, ssp->ier);
+	}
+	DBG_EXIT();
+}
+
+static void shakti_serial_stop_rx(struct uart_port *port)
+{
+	struct shakti_serial_port *ssp = port_to_shakti_serial_port(port);
+
+	DBG_ENTER();
+	if (!ssp->polling_mode) {
+		ssp->ier &= ~SHAKTI_UART_IEN_RX_NOT_EMPTY_MASK;
+		__ssp_write_ier(ssp, ssp->ier);
+	}
+	DBG_EXIT();
+}
+
+static void shakti_serial_start_tx(struct uart_port *port)
+{
+	struct shakti_serial_port *ssp = port_to_shakti_serial_port(port);
+
+	DBG_ENTER();
+	if (!ssp->polling_mode) {
+		ssp->ier |= SHAKTI_UART_IEN_TX_EMPTY_MASK;
+		__ssp_write_ier(ssp, ssp->ier);
+		/* Kick TX immediately */
+		__ssp_transmit_chars(ssp);
+	} else {
+		/* Polling mode: push chars synchronously */
+		__ssp_transmit_chars(ssp);
+	}
+	DBG_EXIT();
+}
+
+static irqreturn_t shakti_serial_irq(int irq, void *dev_id)
+{
+	struct shakti_serial_port *ssp = dev_id;
+	struct uart_port *port = &ssp->port;
+	struct tty_port *tport;
+	u16 status;
+	unsigned int ch;
+	unsigned int flag;
+
+	DBG_ENTER();
+
+	uart_port_lock(port);
+
+	status = __ssp_read_status(ssp);
+	if (!status) {
+		uart_port_unlock(port);
+		DBG_EXIT();
+		return IRQ_NONE;
+	}
+
+	tport = &port->state->port;
+
+	/* RX handling */
+	if ((ssp->ier & SHAKTI_UART_IEN_RX_NOT_EMPTY_MASK) &&
+	    (status & SHAKTI_UART_STATUS_RX_NOT_EMPTY_MASK)) {
+
+		do {
+			ch = __ssp_readl(ssp, SHAKTI_UART_RCV_REG_OFFS) & 0xFF;
+			flag = TTY_NORMAL;
+
+			if (status & SHAKTI_UART_STATUS_BREAK_ERROR_MASK)
+				flag = TTY_BREAK;
+			else if (status & SHAKTI_UART_STATUS_PARITY_ERROR_MASK)
+				flag = TTY_PARITY;
+			else if (status & SHAKTI_UART_STATUS_FRAME_ERROR_MASK)
+				flag = TTY_FRAME;
+
+			uart_insert_char(port,
+					 status,
+					 SHAKTI_UART_STATUS_OVERRUN_ERROR_MASK,
+					 ch, flag);
+
+			status = __ssp_read_status(ssp);
+		} while (status & SHAKTI_UART_STATUS_RX_NOT_EMPTY_MASK);
+
+		tty_flip_buffer_push(tport);
+	}
+
+	/* TX handling */
+	if ((ssp->ier & SHAKTI_UART_IEN_TX_EMPTY_MASK) &&
+	    (status & SHAKTI_UART_STATUS_TX_EMPTY_MASK))
+		__ssp_transmit_chars(ssp);
+
+	uart_unlock_and_check_sysrq(port);
+
+	DBG_EXIT();
+	return IRQ_HANDLED;
+}
+
+static unsigned int shakti_serial_tx_empty(struct uart_port *port)
+{
+	struct shakti_serial_port *ssp = port_to_shakti_serial_port(port);
+	u16 status = __ssp_read_status(ssp);
+
+	return (status & SHAKTI_UART_STATUS_TX_EMPTY_MASK) ? TIOCSER_TEMT : 0;
+}
+
+static unsigned int shakti_serial_get_mctrl(struct uart_port *port)
+{
+	return TIOCM_CAR | TIOCM_CTS | TIOCM_DSR;
+}
+
+static void shakti_serial_set_mctrl(struct uart_port *port, unsigned int mctrl) { }
+static void shakti_serial_break_ctl(struct uart_port *port, int break_state) { }
+
+static void __ssp_update_div(struct shakti_serial_port *ssp)
+{
+	u16 div = DIV_ROUND_CLOSEST(ssp->port.uartclk,
+				    ssp->baud_rate * 16);
+
+	writew_relaxed(div, ssp->port.membase + SHAKTI_UART_BAUD_OFFS);
+}
+
+static void __ssp_update_baud_rate(struct shakti_serial_port *ssp,
+				   unsigned int rate)
+{
+	if (ssp->baud_rate == rate)
+		return;
+
+	ssp->baud_rate = rate;
+	__ssp_update_div(ssp);
+}
+
+static void __ssp_set_stop_bits(struct shakti_serial_port *ssp, char nstop)
+{
+	/* NOP due to HW bug on CONTROL register */
+	__ssp_write_ctrl(ssp,
+			 (__ssp_read_ctrl(ssp) &
+			  ~SHAKTI_UART_CONTROL_STOP_BITS_MASK));
+}
+
+static void __ssp_set_parity(struct shakti_serial_port *ssp, char parity)
+{
+	/* NOP due to HW bug on CONTROL register */
+	__ssp_write_ctrl(ssp,
+			 (__ssp_read_ctrl(ssp) &
+			  ~SHAKTI_UART_CONTROL_PARITY_MASK));
+}
+
+static void __ssp_set_char_size(struct shakti_serial_port *ssp, char size)
+{
+	/* NOP due to HW bug on CONTROL register */
+	__ssp_write_ctrl(ssp,
+			 (__ssp_read_ctrl(ssp) &
+			  ~SHAKTI_UART_CONTROL_CHAR_SIZE_MASK));
+}
+
+static int shakti_serial_startup(struct uart_port *port)
+{
+	struct shakti_serial_port *ssp = port_to_shakti_serial_port(port);
+	int ret;
+
+	DBG_ENTER();
+
+	/* Try interrupt mode first */
+	ssp->polling_mode = false;
+
+	if (port->irq >= 0) {
+		ret = request_irq(port->irq, shakti_serial_irq, 0,
+				  dev_name(ssp->dev), ssp);
+		if (ret) {
+			dev_warn(ssp->dev,
+				 "failed to request irq %d, fallback to polling mode (%d)\n",
+				 port->irq, ret);
+			ssp->polling_mode = true;
+		} else {
+			/* Enable RX interrupts by default */
+			ssp->ier |= SHAKTI_UART_IEN_RX_NOT_EMPTY_MASK;
+			__ssp_write_ier(ssp, ssp->ier);
+		}
+	} else {
+		dev_warn(ssp->dev,
+			 "no IRQ configured, using polling mode\n");
+		ssp->polling_mode = true;
+	}
+
+	if (ssp->polling_mode)
+		pr_info("shakti-uart: Using polling mode (no IRQ)\n");
+
+	DBG_EXIT();
+	return 0;
+}
+
+static void shakti_serial_shutdown(struct uart_port *port)
+{
+	struct shakti_serial_port *ssp = port_to_shakti_serial_port(port);
+
+	DBG_ENTER();
+
+	if (!ssp->polling_mode) {
+		/* Disable all interrupts and free IRQ */
+		ssp->ier = 0;
+		__ssp_write_ier(ssp, ssp->ier);
+		free_irq(port->irq, ssp);
+	}
+
+	DBG_EXIT();
+}
+
+static int shakti_serial_clk_notifier(struct notifier_block *nb,
+				      unsigned long event, void *data)
+{
+	struct clk_notifier_data *cnd = data;
+	struct shakti_serial_port *ssp = notifier_to_shakti_serial_port(nb);
+
+	if (event == POST_RATE_CHANGE &&
+	    ssp->port.uartclk != cnd->new_rate) {
+		ssp->port.uartclk = cnd->new_rate;
+		__ssp_update_div(ssp);
+	}
+	return NOTIFY_OK;
+}
+
+static void shakti_serial_set_termios(struct uart_port *port,
+				      struct ktermios *termios,
+				      const struct ktermios *old)
+{
+	struct shakti_serial_port *ssp = port_to_shakti_serial_port(port);
+	unsigned long flags;
+	int rate;
+	char nstop, parity, size;
+
+	/* Char size */
+	switch (termios->c_cflag & CSIZE) {
+	case CS5:
+		size = 5;
+		break;
+	case CS6:
+		size = 6;
+		break;
+	case CS7:
+		size = 7;
+		break;
+	case CS8:
+	default:
+		size = 8;
+		break;
+	}
+	__ssp_set_char_size(ssp, size);
+
+	/* Parity */
+	parity = (termios->c_cflag & PARENB) ?
+		 ((termios->c_cflag & PARODD) ? 'o' : 'e') : 'n';
+	__ssp_set_parity(ssp, parity);
+
+	/* Stop bits */
+	nstop = (termios->c_cflag & CSTOPB) ? 2 : 1;
+	__ssp_set_stop_bits(ssp, nstop);
+
+	/* Baud */
+	rate = uart_get_baud_rate(port, termios, old, 0,
+				  ssp->port.uartclk / 16);
+	__ssp_update_baud_rate(ssp, rate);
+
+	uart_port_lock_irqsave(&ssp->port, &flags);
+	uart_update_timeout(port, termios->c_cflag, rate);
+
+	ssp->port.read_status_mask = SHAKTI_UART_STATUS_OVERRUN_ERROR_MASK;
+	if (termios->c_iflag & INPCK)
+		ssp->port.read_status_mask |=
+			SHAKTI_UART_STATUS_PARITY_ERROR_MASK |
+			SHAKTI_UART_STATUS_FRAME_ERROR_MASK;
+	if (termios->c_iflag & (BRKINT | PARMRK))
+		ssp->port.read_status_mask |=
+			SHAKTI_UART_STATUS_BREAK_ERROR_MASK;
+
+	if ((termios->c_cflag & CREAD) == 0)
+		ssp->ier &= ~SHAKTI_UART_IEN_RX_NOT_EMPTY_MASK;
+	else
+		ssp->ier |= SHAKTI_UART_IEN_RX_NOT_EMPTY_MASK;
+
+	if (!ssp->polling_mode)
+		__ssp_write_ier(ssp, ssp->ier);
+
+	uart_port_unlock_irqrestore(&ssp->port, flags);
+}
+
+static void shakti_serial_release_port(struct uart_port *port) { }
+static int  shakti_serial_request_port(struct uart_port *port) { return 0; }
+
+static void shakti_serial_config_port(struct uart_port *port, int flags)
+{
+	struct shakti_serial_port *ssp = port_to_shakti_serial_port(port);
+
+	ssp->port.type = PORT_SHAKTI;
+}
+
+static int  shakti_serial_verify_port(struct uart_port *port,
+				      struct serial_struct *ser)
+{
+	return -EINVAL;
+}
+
+static const char *shakti_serial_type(struct uart_port *port)
+{
+	return port->type == PORT_SHAKTI ? "Shakti UART" : NULL;
+}
+
+#ifdef CONFIG_CONSOLE_POLL
+static int shakti_serial_poll_get_char(struct uart_port *port)
+{
+	struct shakti_serial_port *ssp = port_to_shakti_serial_port(port);
+	u16 status;
+
+	status = __ssp_read_status(ssp);
+	if (status & SHAKTI_UART_STATUS_RX_NOT_EMPTY_MASK)
+		return readl_relaxed(port->membase +
+				     SHAKTI_UART_RCV_REG_OFFS) & 0xFF;
+
+	return NO_POLL_CHAR;
+}
+
+static void shakti_serial_poll_put_char(struct uart_port *port,
+					unsigned char c)
+{
+	struct shakti_serial_port *ssp = port_to_shakti_serial_port(port);
+
+	__ssp_wait_for_xmitr(ssp);
+	__ssp_transmit_char(ssp, c);
+}
+#endif
+
+/* ---------- EARLYCON (safe 16-bit reads for status) ---------- */
+#ifdef CONFIG_SERIAL_EARLYCON
+static void early_shakti_serial_putc(struct uart_port *port,
+				     unsigned char c)
+{
+	/* Poll TX_FULL via 16-bit read */
+	while (__ssp_early_readw(port, SHAKTI_UART_STATUS_OFFS) &
+	       SHAKTI_UART_STATUS_TX_FULL_MASK)
+		cpu_relax();
+
+	__ssp_early_writel(c, SHAKTI_UART_TX_REG_OFFS, port);
+	/* TX is 32-bit WO */
+}
+
+static void early_shakti_serial_write(struct console *con,
+				      const char *s, unsigned int n)
+{
+	struct earlycon_device *dev = con->data;
+
+	uart_console_write(&dev->port, s, n, early_shakti_serial_putc);
+}
+
+static int __init early_shakti_serial_setup(struct earlycon_device *dev,
+					    const char *options)
+{
+	if (!dev->port.membase)
+		return -ENODEV;
+	dev->con->write = early_shakti_serial_write;
+	return 0;
+}
+
+OF_EARLYCON_DECLARE(shakti, "shakti", early_shakti_serial_setup);
+#endif /* CONFIG_SERIAL_EARLYCON */
+
+/* ---------- Console (nbcon) ---------- */
+#ifdef CONFIG_SERIAL_SHAKTI_CONSOLE
+static struct shakti_serial_port *shakti_serial_console_ports[SHAKTI_SERIAL_MAX_PORTS];
+
+static void shakti_serial_console_putchar(struct uart_port *port,
+					  unsigned char ch)
+{
+	struct shakti_serial_port *ssp = port_to_shakti_serial_port(port);
+
+	__ssp_wait_for_xmitr(ssp);
+	__ssp_transmit_char(ssp, ch);
+	ssp->console_line_ended = (ch == '\n');
+}
+
+static void shakti_serial_device_lock(struct console *co,
+				      unsigned long *flags)
+{
+	struct uart_port *up =
+		&shakti_serial_console_ports[co->index]->port;
+
+	__uart_port_lock_irqsave(up, flags);
+}
+
+static void shakti_serial_device_unlock(struct console *co,
+					unsigned long flags)
+{
+	struct uart_port *up =
+		&shakti_serial_console_ports[co->index]->port;
+
+	__uart_port_unlock_irqrestore(up, flags);
+}
+
+static void shakti_serial_console_write_atomic(struct console *co,
+					       struct nbcon_write_context *wctxt)
+{
+	struct shakti_serial_port *ssp;
+	struct uart_port *port;
+	u16 ier;
+
+	ssp = shakti_serial_console_ports[co->index];
+	if (!ssp)
+		return;
+
+	if (!nbcon_enter_unsafe(wctxt))
+		return;
+
+	port = &ssp->port;
+
+	ier = __ssp_read_ier(ssp);
+	__ssp_write_ier(ssp, 0);
+
+	if (!ssp->console_line_ended)
+		uart_console_write(port, "\n", 1,
+				   shakti_serial_console_putchar);
+
+	uart_console_write(port, wctxt->outbuf, wctxt->len,
+			   shakti_serial_console_putchar);
+
+	__ssp_write_ier(ssp, ier);
+	nbcon_exit_unsafe(wctxt);
+}
+
+static void shakti_serial_console_write_thread(struct console *co,
+					       struct nbcon_write_context *wctxt)
+{
+	struct shakti_serial_port *ssp;
+	struct uart_port *port;
+	u16 ier;
+	int i, len;
+
+	ssp = shakti_serial_console_ports[co->index];
+	if (!ssp)
+		return;
+
+	if (!nbcon_enter_unsafe(wctxt))
+		return;
+
+	port = &ssp->port;
+	ier = __ssp_read_ier(ssp);
+	__ssp_write_ier(ssp, 0);
+
+	if (nbcon_exit_unsafe(wctxt)) {
+		len = READ_ONCE(wctxt->len);
+		for (i = 0; i < len; i++) {
+			if (!nbcon_enter_unsafe(wctxt))
+				break;
+			uart_console_write(port, wctxt->outbuf + i, 1,
+					   shakti_serial_console_putchar);
+			if (!nbcon_exit_unsafe(wctxt))
+				break;
+		}
+	}
+
+	while (!nbcon_enter_unsafe(wctxt))
+		nbcon_reacquire_nobuf(wctxt);
+
+	__ssp_write_ier(ssp, ier);
+	nbcon_exit_unsafe(wctxt);
+}
+
+static int shakti_serial_console_setup(struct console *co, char *options)
+{
+	struct shakti_serial_port *ssp;
+	int baud = SHAKTI_DEFAULT_BAUD_RATE;
+	int bits = 8;
+	int parity = 'n';
+	int flow = 'n';
+
+	if (co->index < 0 || co->index >= SHAKTI_SERIAL_MAX_PORTS)
+		return -ENODEV;
+
+	ssp = shakti_serial_console_ports[co->index];
+	if (!ssp)
+		return -ENODEV;
+
+	ssp->console_line_ended = true;
+
+	if (options)
+		uart_parse_options(options, &baud, &parity, &bits, &flow);
+
+	return uart_set_options(&ssp->port, co, baud, parity, bits, flow);
+}
+
+static struct uart_driver shakti_serial_uart_driver; /* fwd */
+
+static struct console shakti_serial_console = {
+	.name          = SHAKTI_TTY_PREFIX,
+	.write_atomic  = shakti_serial_console_write_atomic,
+	.write_thread  = shakti_serial_console_write_thread,
+	.device_lock   = shakti_serial_device_lock,
+	.device_unlock = shakti_serial_device_unlock,
+	.device        = uart_console_device,
+	.setup         = shakti_serial_console_setup,
+	.flags         = CON_PRINTBUFFER | CON_NBCON,
+	.index         = -1,
+	.data          = &shakti_serial_uart_driver,
+};
+
+static int __init shakti_console_init(void)
+{
+	register_console(&shakti_serial_console);
+	return 0;
+}
+console_initcall(shakti_console_init);
+
+static void __ssp_add_console_port(struct shakti_serial_port *ssp)
+{
+	shakti_serial_console_ports[ssp->port.line] = ssp;
+}
+static void __ssp_remove_console_port(struct shakti_serial_port *ssp)
+{
+	shakti_serial_console_ports[ssp->port.line] = NULL;
+}
+#define SHAKTI_SERIAL_CONSOLE (&shakti_serial_console)
+#else
+#define SHAKTI_SERIAL_CONSOLE NULL
+static void __ssp_add_console_port(struct shakti_serial_port *ssp) { }
+static void __ssp_remove_console_port(struct shakti_serial_port *ssp) { }
+#endif /* CONFIG_SERIAL_SHAKTI_CONSOLE */
+
+/* ---------- uart_ops/driver ---------- */
+static const struct uart_ops shakti_serial_uops = {
+	.tx_empty      = shakti_serial_tx_empty,
+	.set_mctrl     = shakti_serial_set_mctrl,
+	.get_mctrl     = shakti_serial_get_mctrl,
+	.stop_tx       = shakti_serial_stop_tx,
+	.start_tx      = shakti_serial_start_tx,
+	.stop_rx       = shakti_serial_stop_rx,
+	.break_ctl     = shakti_serial_break_ctl,
+	.startup       = shakti_serial_startup,
+	.shutdown      = shakti_serial_shutdown,
+	.set_termios   = shakti_serial_set_termios,
+	.type          = shakti_serial_type,
+	.release_port  = shakti_serial_release_port,
+	.request_port  = shakti_serial_request_port,
+	.config_port   = shakti_serial_config_port,
+	.verify_port   = shakti_serial_verify_port,
+#ifdef CONFIG_CONSOLE_POLL
+	.poll_get_char = shakti_serial_poll_get_char,
+	.poll_put_char = shakti_serial_poll_put_char,
+#endif
+};
+
+static struct uart_driver shakti_serial_uart_driver = {
+	.owner      = THIS_MODULE,
+	.driver_name= SHAKTI_SERIAL_NAME,
+	.dev_name   = SHAKTI_TTY_PREFIX,
+	.nr         = SHAKTI_SERIAL_MAX_PORTS,
+	.cons       = SHAKTI_SERIAL_CONSOLE,
+};
+
+/* ---------- probe/remove ---------- */
+static int shakti_serial_probe(struct platform_device *pdev)
+{
+	struct shakti_serial_port *ssp;
+	struct resource *mem;
+	struct clk *clk;
+	void __iomem *base;
+	int irq, id, r;
+
+	DBG_ENTER();
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq == -EPROBE_DEFER)
+		return irq;
+
+	mem = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	base = devm_ioremap_resource(&pdev->dev, mem);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	clk = devm_clk_get_enabled(&pdev->dev, NULL);
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+
+	id = of_alias_get_id(pdev->dev.of_node, "serial");
+	if (id < 0)
+		return id;
+#ifdef CONFIG_SERIAL_SHAKTI_CONSOLE
+	if (id >= SHAKTI_SERIAL_MAX_PORTS)
+		return -EINVAL;
+#endif
+
+	ssp = devm_kzalloc(&pdev->dev, sizeof(*ssp), GFP_KERNEL);
+	if (!ssp)
+		return -ENOMEM;
+
+	ssp->port.dev      = &pdev->dev;
+	ssp->port.type     = PORT_SHAKTI;
+	ssp->port.iotype   = UPIO_MEM;
+	ssp->port.irq      = irq;
+	ssp->port.fifosize = SHAKTI_TX_FIFO_DEPTH;
+	ssp->port.ops      = &shakti_serial_uops;
+	ssp->port.line     = id;
+	ssp->port.mapbase  = mem->start;
+	ssp->port.membase  = base;
+	ssp->dev           = &pdev->dev;
+	ssp->clk           = clk;
+
+	ssp->clk_notifier.notifier_call = shakti_serial_clk_notifier;
+
+	r = clk_notifier_register(ssp->clk, &ssp->clk_notifier);
+	if (r)
+		return r;
+
+	ssp->port.uartclk = clk_get_rate(ssp->clk);
+	ssp->baud_rate    = SHAKTI_DEFAULT_BAUD_RATE;
+	__ssp_update_div(ssp);
+
+	platform_set_drvdata(pdev, ssp);
+
+	/* RX threshold = 1 */
+	writeb_relaxed(1, ssp->port.membase + SHAKTI_UART_RX_THRESHOLD_OFFS);
+
+	/* Initial interrupt mask: enable RX, TX will be enabled in start_tx */
+	ssp->ier = SHAKTI_UART_IEN_RX_NOT_EMPTY_MASK;
+
+	__ssp_add_console_port(ssp);
+
+	r = uart_add_one_port(&shakti_serial_uart_driver, &ssp->port);
+	if (r) {
+		__ssp_remove_console_port(ssp);
+		clk_notifier_unregister(ssp->clk, &ssp->clk_notifier);
+		return r;
+	}
+
+	DBG_EXIT();
+	return 0;
+}
+
+static void shakti_serial_remove(struct platform_device *pdev)
+{
+	struct shakti_serial_port *ssp = platform_get_drvdata(pdev);
+
+	__ssp_remove_console_port(ssp);
+	uart_remove_one_port(&shakti_serial_uart_driver, &ssp->port);
+	clk_notifier_unregister(ssp->clk, &ssp->clk_notifier);
+}
+
+/* ---------- PM ---------- */
+static int shakti_serial_suspend(struct device *dev)
+{
+	struct shakti_serial_port *ssp = dev_get_drvdata(dev);
+
+	return uart_suspend_port(&shakti_serial_uart_driver, &ssp->port);
+}
+
+static int shakti_serial_resume(struct device *dev)
+{
+	struct shakti_serial_port *ssp = dev_get_drvdata(dev);
+
+	return uart_resume_port(&shakti_serial_uart_driver, &ssp->port);
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(shakti_uart_pm_ops,
+				shakti_serial_suspend,
+				shakti_serial_resume);
+
+/* ---------- OF match / platform ---------- */
+static const struct of_device_id shakti_serial_of_match[] = {
+	{ .compatible = "iiitm,shakti-uart" },
+	{ /* sentinel */ },
+};
+MODULE_DEVICE_TABLE(of, shakti_serial_of_match);
+
+static struct platform_driver shakti_serial_platform_driver = {
+	.probe  = shakti_serial_probe,
+	.remove = shakti_serial_remove,
+	.driver = {
+		.name           = SHAKTI_SERIAL_NAME,
+		.pm             = pm_sleep_ptr(&shakti_uart_pm_ops),
+		.of_match_table = shakti_serial_of_match,
+	},
+};
+
+/* ---------- Module init/exit ---------- */
+static int __init shakti_serial_init(void)
+{
+	int r;
+
+	r = uart_register_driver(&shakti_serial_uart_driver);
+	if (r)
+		return r;
+
+	r = platform_driver_register(&shakti_serial_platform_driver);
+	if (r) {
+		uart_unregister_driver(&shakti_serial_uart_driver);
+		return r;
+	}
+	return 0;
+}
+module_init(shakti_serial_init);
+
+static void __exit shakti_serial_exit(void)
+{
+	platform_driver_unregister(&shakti_serial_platform_driver);
+	uart_unregister_driver(&shakti_serial_uart_driver);
+}
+module_exit(shakti_serial_exit);
+
+MODULE_DESCRIPTION("Shakti UART serial driver for FPGA bring-up (debug)");
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("IITM");
+
