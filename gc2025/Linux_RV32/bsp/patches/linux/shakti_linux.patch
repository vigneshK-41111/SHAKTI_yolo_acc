diff --git a/arch/riscv/boot/dts/shakti/shakti_nexys_video.dts b/arch/riscv/boot/dts/shakti/shakti_nexys_video.dts
new file mode 100644
index 000000000000..bee1caeb31c2
--- /dev/null
+++ b/arch/riscv/boot/dts/shakti/shakti_nexys_video.dts
@@ -0,0 +1,153 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Device Tree for Shakti SoS C-Class (Nexys Video FPGA)
+ * Maintainer: Umesh Gowda (IIT Madras)
+ * Linux Kernel 6.12.x – Tested configuration
+ *
+ * - System clock: 40 MHz
+ * - UART0: 0x00011300 (IRQ 11, console + earlycon)
+ * - SPI1:  0x00020100 (IRQ 10, SD/MMC-over-SPI)
+ * - Memory: 512MB DDR @ 0x80000000
+ * - Boot: From SD card (mmcblk0p2 as rootfs)
+ */
+
+/dts-v1/;
+
+/ {
+    #address-cells = <2>;
+    #size-cells = <2>;
+    compatible = "shakti,sos-nexys-video", "simple-bus";
+    model = "Shakti SoS C-Class (Nexys Video FPGA)";
+
+    aliases {
+        serial0 = &uart0;
+        spi1    = &spi1;
+        mmc0    = &mmc_slot;
+    };
+
+    chosen {
+        stdout-path = "serial0:19200n8";
+        bootargs = "console=ttySHK0,19200 earlycon=shakti,mmio,0x00011300,19200 loglevel=8 debug ignore_loglevel root=/dev/mmcblk0p2 rw rootwait rootfstype=ext4 rootdelay=2";
+    };
+
+    memory@80000000 {
+        device_type = "memory";
+        reg = <0x0 0x80000000 0x0 0x20000000>; /* 512 MiB */
+    };
+
+    /* ---------------- CPU ---------------- */
+    cpus {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        timebase-frequency = <>;
+
+        cpu0: cpu@0 {
+            device_type = "cpu";
+            compatible = "riscv";
+            reg = <0>;
+            riscv,isa = "rv64imac";
+            mmu-type = "riscv,sv39";
+            clock-frequency = <40000000>;
+
+            cpu0_intc: interrupt-controller {
+                #interrupt-cells = <1>;
+                compatible = "riscv,cpu-intc";
+                interrupt-controller;
+            };
+        };
+    };
+
+    /* ---------------- SoC ---------------- */
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+        compatible = "shakti,sos-soc", "simple-bus";
+        ranges;
+
+        /* ---------------- PLIC ---------------- */
+        plic: interrupt-controller@0c000000 {
+            compatible = "riscv,plic0";
+            reg = <0x0 0x0c000000 0x0 0x00400000>;
+            interrupt-controller;
+            #interrupt-cells = <1>;
+            riscv,max-priority = <7>;
+            riscv,ndev = <64>;
+            interrupts-extended = <&cpu0_intc 11>;
+            riscv,num-contexts = <1>;
+            status = "okay";
+        };
+
+        /* ---------------- CLINT ---------------- */
+        clint@02000000 {
+            compatible = "riscv,clint0";
+            reg = <0x0 0x02000000 0x0 0x000c0000>;
+            interrupts-extended = <&cpu0_intc 3 &cpu0_intc 7>;
+            status = "okay";
+        };
+
+        /* ---------------- Fixed Clocks ---------------- */
+        uartclk0: uartclk0 {
+            compatible = "fixed-clock";
+            #clock-cells = <0>;
+            clock-frequency = <40000000>;
+            status = "okay";
+        };
+
+        spiclk: spiclk {
+            compatible = "fixed-clock";
+            #clock-cells = <0>;
+            clock-frequency = <40000000>;
+            status = "okay";
+        };
+
+        /* ---------------- PinMux ---------------- */
+        pinmux: pinmux@41500 {
+            compatible = "shakti,pinmux";
+            reg = <0x0 0x00041500 0x0 0x100>;
+            status = "okay";
+        };
+
+        /* ---------------- UART0 (console) ---------------- */
+        uart0: serial@11300 {
+            compatible = "iiitm,shakti-uart";
+            reg = <0x0 0x00011300 0x0 0x100>;
+            interrupts = <11>;                  /* PLIC IRQ ID 11 */
+            interrupt-parent = <&plic>;
+            clocks = <&uartclk0>;
+            clock-names = "uart";
+            current-speed = <115200>;
+            reg-io-width = <4>;
+            fifo-size = <16>;
+            status = "okay";
+        };
+
+        /* ---------------- SPI1 (SD/MMC-over-SPI) ---------------- */
+        spi1: spi@20000 {
+            #address-cells = <1>;
+            #size-cells = <0>;
+            compatible = "shakti,spi1";
+            reg = <0x0 0x00020000 0x0 0x1000>;
+            interrupts = <10>;                  /* PLIC IRQ ID 10 */
+            interrupt-parent = <&plic>;
+            clocks = <&spiclk>;
+            clock-names = "spi_clk";
+            shakti,controller = <1>;
+            shakti,spi-frequency = <2000000>;
+            shakti,lsb-first = <0>;
+            shakti,communication-mode = <3>;
+            shakti,fifo-depth = <16>;
+            status = "okay";
+
+            /* ---- SD/MMC slot via SPI ---- */
+            mmc_slot: sd-card@0 {
+                compatible = "mmc-spi-slot";
+                reg = <0>;                     /* CS0 */
+                voltage-ranges = <3300 3300>;
+                spi-max-frequency = <20000000>;
+                broken-cd;
+                status = "okay";
+            };
+        };
+    };
+};
+
diff --git a/arch/riscv/boot/dts/shakti/shakti_yamuna.dts b/arch/riscv/boot/dts/shakti/shakti_yamuna.dts
new file mode 100644
index 000000000000..a8c8839c6bf3
--- /dev/null
+++ b/arch/riscv/boot/dts/shakti/shakti_yamuna.dts
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Device Tree for Shakti SoS C-Class (Yamuna)
+ * Maintainer: Umesh Gowda (IIT Madras)
+ * Linux Kernel 6.12.x – Corrected configuration
+ *
+ * - System clock: 50 MHz
+ * - UART0: 0x00011300 (IRQ 11, console + earlycon)
+ * - SPI1:  0x00020100 (IRQ 10, SD/MMC-over-SPI)
+ * - Memory: 252MB available DDR @ 0x80400000 (4MB reserved by OpenSBI)
+ * - Boot: From SD card (mmcblk0p2 as rootfs)
+ */
+
+/dts-v1/;
+
+/ {
+    /*
+     * CRITICAL FIX: Changed cells to <1> for 32-bit (rv32) architecture.
+     * #address-cells = <2> and #size-cells = <2> are for 64-bit (rv64).
+     */
+    #address-cells = <1>;
+    #size-cells = <1>;
+    compatible = "shakti,sos-yamuna", "simple-bus";
+    model = "Shakti C-Class (yamuna)";
+
+    aliases {
+        serial0 = &uart0;
+        spi1    = &spi1;
+        mmc0    = &mmc_slot;
+    };
+
+    chosen {
+        stdout-path = "serial0:115200n8";
+        bootargs = "console=ttySHK0,115200 earlycon=shakti,mmio,0x00011300,115200 loglevel=8 debug ignore_loglevel root=/dev/mmcblk0p2 rw rootwait rootfstype=ext4 rootdelay=2";
+    };
+
+    /*
+     * CRITICAL FIX: Memory starts at 0x80400000 to avoid OpenSBI reserved region
+     * Updated 'reg' to use 32-bit format (<1> address cell, <1> size cell).
+     */
+    memory@80400000 {
+        device_type = "memory";
+        reg = <0x80400000 0x0FC00000>; /* 252 MiB of available memory */
+    };
+
+    /* ---------------- CPU ---------------- */
+    cpus {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        timebase-frequency = <10000000>;
+
+        cpu0: cpu@0 {
+            device_type = "cpu";
+            compatible = "riscv";
+            reg = <0>;
+            riscv,isa = "rv32imac";
+            mmu-type = "riscv,sv32";
+            clock-frequency = <97656>;
+
+            cpu0_intc: interrupt-controller {
+                #interrupt-cells = <1>;
+                compatible = "riscv,cpu-intc";
+                interrupt-controller;
+            };
+        };
+    };
+
+    /* ---------------- SoC ---------------- */
+    soc {
+        #address-cells = <1>;
+        #size-cells = <1>;
+        compatible = "shakti,sos-soc", "simple-bus";
+        /* Use a simple 1-to-1 address space mapping */
+        ranges;
+
+        /* ---------------- PLIC ---------------- */
+        plic: interrupt-controller@c000000 {
+            compatible = "riscv,plic0";
+            reg = <0x0c000000 0x00400000>;
+            interrupt-controller;
+            #interrupt-cells = <1>;
+            riscv,max-priority = <7>;
+            riscv,ndev = <64>;
+            interrupts-extended = <&cpu0_intc 11>;
+            riscv,num-contexts = <1>;
+            status = "okay";
+        };
+
+        /* ---------------- CLINT ---------------- */
+        clint@2000000 {
+            compatible = "riscv,clint0";
+            reg = <0x02000000 0x000c0000>;
+            interrupts-extended = <&cpu0_intc 3 &cpu0_intc 7>;
+            status = "okay";
+        };
+
+        /* ---------------- Fixed Clocks ---------------- */
+        uartclk0: uartclk0 {
+            compatible = "fixed-clock";
+            #clock-cells = <0>;
+            clock-frequency = <50000000>;
+            status = "okay";
+        };
+
+        spiclk: spiclk {
+            compatible = "fixed-clock";
+            #clock-cells = <0>;
+            clock-frequency = <50000000>;
+            status = "okay";
+        };
+
+        /* ---------------- PinMux ---------------- */
+        pinmux: pinmux@41500 {
+            compatible = "shakti,pinmux";
+            reg = <0x00041500 0x100>;
+            status = "disable";
+        };
+
+        /* ---------------- UART0 (console) ---------------- */
+        uart0: serial@11300 {
+            compatible = "iiitm,shakti-uart";
+            reg = <0x00011300 0x100>;
+            interrupts = <11>;
+            interrupt-parent = <&plic>;
+            clocks = <&uartclk0>;
+            clock-names = "uart";
+            current-speed = <115200>;
+            reg-io-width = <4>;
+            fifo-size = <16>;
+            status = "okay";
+        };
+
+        /* ---------------- SPI1 (SD/MMC-over-SPI) ---------------- */
+        spi1: spi@20100 {
+            #address-cells = <1>;
+            #size-cells = <0>;
+            compatible = "shakti,spi1";
+            reg = <0x00020100 0x1000>;
+            interrupts = <10>;
+            interrupt-parent = <&plic>;
+            clocks = <&spiclk>;
+            clock-names = "spi_clk";
+            shakti,controller = <1>;
+            shakti,spi-frequency = <2000000>;
+            shakti,lsb-first = <0>;
+            shakti,communication-mode = <3>;
+            shakti,fifo-depth = <16>;
+            status = "okay";
+
+            /* ---- SD/MMC slot via SPI ---- */
+            mmc_slot: sd-card@0 {
+                compatible = "mmc-spi-slot";
+                reg = <0>;
+                voltage-ranges = <3300 3300>;
+                spi-max-frequency = <0x002625a0>;
+                broken-cd;
+                status = "okay";
+            };
+        };
+    };
+};
