+/**
+ * shakti_spi_configure_pinmux - Configure pinmux for SPI
+ */
+static int __maybe_unused shakti_spi_configure_pinmux(struct shakti_spi *spi)
+{
+    struct device *dev;
+    void __iomem *pinmux_base;
+    u32 pinmux_value;
+    
+    if (!spi || !spi->dev) {
+        SHAKTI_ERR("Invalid spi or dev\n");
+        return -EINVAL;
+    }
+    
+    dev = spi->dev;
+    
+    /* Map pinmux register with proper size */
+    pinmux_base = devm_ioremap(dev, PINMUX_CONFIGURE_REG, 0x1000);
+    if (!pinmux_base) {
+        SHAKTI_ERR("Failed to map pinmux register at 0x%x\n", PINMUX_CONFIGURE_REG);
+        return -ENOMEM;
+    }
+    
+    /* Read current value with error checking */
+    pinmux_value = readl_relaxed(pinmux_base);
+    
+    /* Configure for SPI */
+    pinmux_value &= ~SHAKTI_SPI_PINMUX_MASK;
+    pinmux_value |= SHAKTI_SPI_PINMUX_SET;
+    
+    /* Write back */
+    writel_relaxed(pinmux_value, pinmux_base);
+    
+    /* Store the base address if needed later */
+    spi->pinmux_base = pinmux_base;
+    
+    return 0;
+}
