+/* Simplified and fixed probe function */
+static int shakti_spi_probe(struct platform_device *pdev)
+{
+    struct spi_controller *controller;
+    struct shakti_spi *spi;
+    struct resource *res;
+    int ret;
+    const struct of_device_id *match;
+
+    /* Allocate controller */
+    controller = spi_alloc_host(&pdev->dev, sizeof(struct shakti_spi));
+    if (!controller) {
+        SHAKTI_ERR("spi controller allocation failed\n");
+        return -ENOMEM;
+    }
+    
+    platform_set_drvdata(pdev, controller);
+    spi = spi_controller_get_devdata(controller);
+    if (!spi) {
+        SHAKTI_ERR("Failed to get shakti_spi data\n");
+        ret = -ENODEV;
+        goto err_put_controller;
+    }
+    
+    /* Initialize shakti_spi structure */
+    memset(spi, 0, sizeof(*spi));
+    spi->dev = &pdev->dev;
+    spi->controller = controller;
+    spin_lock_init(&spi->lock);
+    
+    /* Get device match data */
+    match = device_get_match_data(&pdev->dev);
+    if (!match) {
+        SHAKTI_ERR("No matching device found\n");
+        ret = -ENODEV;
+        goto err_put_controller;
+    }
+    spi->cfg = (const struct shakti_spi_cfg *)match->data;
+    
+    /* Map registers */
+    res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+    if (!res) {
+        SHAKTI_ERR("No memory resource found\n");
+        ret = -ENODEV;
+        goto err_put_controller;
+    }
+    
+    spi->base = devm_ioremap_resource(&pdev->dev, res);
+    if (IS_ERR(spi->base)) {
+        ret = PTR_ERR(spi->base);
+        SHAKTI_ERR("Failed to map registers: %d\n", ret);
+        goto err_put_controller;
+    }
+    
+    /* Read only essential properties */
+    ret = of_property_read_u32(pdev->dev.of_node, "shakti,controller",
+                   &spi->mode_configuration);
+    if(ret) {
+        SHAKTI_ERR("Controller mode not set\n");
+        ret = -EINVAL;
+        goto err_put_controller;
+    }
+    
+    ret = of_property_read_u32(pdev->dev.of_node, "shakti,spi-frequency",
+                   &spi->spi_rate);
+    if(ret) {
+        SHAKTI_ERR("SPI frequency not set\n");
+        ret = -EINVAL;
+        goto err_put_controller;
+    }
+    
+    /* Set defaults for other properties */
+    spi->fifo_size = SHAKTI_SPI_DEFAULT_DEPTH;
+    spi->lsb_first = 0;
+    spi->comm_mode = 3; /* Full duplex */
+    
+    /* Get clock */
+    spi->clk = devm_clk_get(&pdev->dev, NULL);
+    if (IS_ERR(spi->clk)) {
+        ret = PTR_ERR(spi->clk);
+        SHAKTI_ERR("Unable to find bus clock: %d\n", ret);
+        goto err_put_controller;
+    }
+    
+    /* Enable clock */
+    ret = clk_prepare_enable(spi->clk);
+    if (ret) {
+        SHAKTI_ERR("Unable to enable bus clock: %d\n", ret);
+        goto err_put_controller;
+    }
+    
+    spi->clk_rate = clk_get_rate(spi->clk);
+    if (!spi->clk_rate) {
+        SHAKTI_ERR("clk rate = 0\n");
+        ret = -EINVAL;
+        goto disable_clk;
+    }
+    
+    /* Configure controller */
+    ret = shakti_spi_configure(spi);
+    if (ret) {
+        SHAKTI_ERR("Controller configuration failed: %d\n", ret);
+        goto disable_clk;
+    }
+    
+    /* Setup controller */
+    controller->dev.of_node = pdev->dev.of_node;
+    controller->bus_num = pdev->id;
+    controller->mode_bits = 0;
+    controller->bits_per_word_mask = SPI_BPW_MASK(8);
+    controller->max_speed_hz = spi->clk_rate / (SHAKTI_SPI_MIN_BR + 1);
+    controller->min_speed_hz = spi->clk_rate / (SHAKTI_SPI_MAX_BR + 1);
+    controller->setup = shakti_spi_setup;
+    controller->prepare_message = shakti_spi_prepare_msg;
+    controller->transfer_one = shakti_spi_transfer_one;
+    controller->unprepare_message = shakti_spi_unprepare_msg;
+    controller->flags = SPI_CONTROLLER_MUST_RX | SPI_CONTROLLER_MUST_TX;
+    
+    /* Register controller */
+    ret = devm_spi_register_controller(&pdev->dev, controller);
+    if (ret) {
+        SHAKTI_ERR("spi controller registration failed: %d\n", ret);
+        goto disable_clk;
+    }
+    
+    /* Print a single line for successful registration */
+    pr_info("shakti_spi %s.spi: registered host spi1\n", dev_name(&pdev->dev));
+    
+    return 0;
+    
+disable_clk:
+    clk_disable_unprepare(spi->clk);
+err_put_controller:
+    spi_controller_put(controller);
+    return ret;
+}
+
+/*
+ * shakti_spi_remove - Remove function to remove the module. This function is
+ * useful only when using this as a module.
+ */
+static void shakti_spi_remove(struct platform_device *pdev)
+{
+    struct spi_controller *controller;
+    struct shakti_spi *spi;
+    
+    controller = platform_get_drvdata(pdev);
+    if (!controller) {
+        return;
+    }
+    
+    spi = spi_controller_get_devdata(controller);
+    if (!spi) {
+        return;
+    }
+
+    /* Disable clock */
+    if (spi->clk) {
+        clk_disable_unprepare(spi->clk);
+    }
+}
+
+static const struct of_device_id shakti_spi_of_match[] = {
+    { .compatible = "shakti,spi1", .data = (void *)&shakti_spi1_cfg },
+    {}
+};
+
+MODULE_DEVICE_TABLE(of, shakti_spi_of_match);
+
+static struct platform_driver shakti_spi_driver = {
+    .probe = shakti_spi_probe,
+    .remove = shakti_spi_remove,
+    .driver = {
+        .name = SHAKTI_SPI_DRIVER_NAME,
+        .of_match_table = shakti_spi_of_match,
+    },
+};
+
+module_platform_driver(shakti_spi_driver);
+
+MODULE_ALIAS("platform:" SHAKTI_SPI_DRIVER_NAME);
+MODULE_AUTHOR("Sambhav Jain, Venkatakrishnan Sutharsan");
+MODULE_DESCRIPTION("Shakti SPI driver");
+MODULE_LICENSE("GPL v2");
