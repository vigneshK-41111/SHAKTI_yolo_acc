+static const struct shakti_spi_cfg shakti_spi1_cfg = {
+    .regs = &shakti_spi1_regspec,
+    .baud_rate_div_min = SHAKTI_SPI_MIN_BR,
+    .baud_rate_div_max = SHAKTI_SPI_MAX_BR,
+    .has_fifo = true,
+};
