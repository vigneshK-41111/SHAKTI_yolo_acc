+++ b/platform/cclass/yamuna/objects.mk
@@ -0,0 +1,38 @@
+#
+# SPDX-License-Identifier: BSD-2-Clause
+#
+# Copyright (c) 2019 Western Digital Corporation or its affiliates.
+# Copyright (c) 2024 Umesh .
+#
+
+# C Compiler and assembler flags.
+platform-cflags-y =
+platform-asflags-y =
+
+# Linker flags
+platform-ldflags-y =
+
+# Platform RISC-V XLEN, ABI, ISA and Code Model configuration.
+PLATFORM_RISCV_XLEN = 32
+PLATFORM_RISCV_ISA = rv$(PLATFORM_RISCV_XLEN)imafdc_zicsr_zifencei
+
+# Space separated list of object file names to be compiled for the platform
+platform-objs-y += platform.o
+
+#
+# Firmware with payload configuration.
+# This bundles OpenSBI and your next-stage bootloader/kernel into a single file.
+#
+FW_PAYLOAD=y
+
+# The payload (e.g., U-Boot, Linux) will be linked at an offset
+# from the start of OpenSBI. The default of 0x200000 is fine for rv64.
+ifeq ($(PLATFORM_RISCV_XLEN), 32)
+FW_PAYLOAD_OFFSET=0x200000
+else
+FW_PAYLOAD_OFFSET=0x200000
+endif
+
+# You will specify the actual payload binary during the make command, like:
+# FW_PAYLOAD_PATH="/path/to/your/u-boot.bin"
+
diff --git a/platform/cclass/yamuna/platform.c b/platform/cclass/yamuna/platform.c
new file mode 100644
index 00000000..b827a07b
--- /dev/null
+++ b/platform/cclass/yamuna/platform.c
@@ -0,0 +1,149 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Yamuna (C-Class) OpenSBI platform
+ *
+ * Notes for OpenSBI v1.8:
+ * - struct sbi_platform_operations in v1.8 does NOT have .ipi_init/.timer_init
+ * - So we init ACLINT MSWI + MTIMER inside early_init() during cold boot.
+ */
+
+#include <sbi/riscv_asm.h>
+#include <sbi/riscv_encoding.h>
+#include <sbi/sbi_const.h>
+#include <sbi/sbi_platform.h>
+
+#include <sbi_utils/ipi/aclint_mswi.h>
+#include <sbi_utils/timer/aclint_mtimer.h>
+/* If you later enable PLIC, uncomment these:
+ * #include <sbi_utils/irqchip/plic.h>
+ */
+
+#include <sbi_utils/serial/shakti-uart.h>
+
+/*
+ * Platform-specific Definitions for Yamuna
+ */
+
+/* From 'MemoryBase' */
+#define YAMUNA_MEMORY_ADDR              0x80000000
+
+/* From 'PLICBase' */
+#define YAMUNA_PLIC_ADDR                0x0C000000
+#define YAMUNA_HART_COUNT               1
+#define YAMUNA_PLIC_SIZE                (0x400000 + (YAMUNA_HART_COUNT * 0x2000))
+#define YAMUNA_PLIC_NUM_SOURCES         128
+
+/* From 'ClintBase' */
+#define YAMUNA_CLINT_ADDR               0x02000000
+#define YAMUNA_ACLINT_MTIMER_FREQ       97656
+
+/* From 'UARTxBase' */
+#define YAMUNA_UART0_ADDR               0x00011300
+#define YAMUNA_UART1_ADDR               0x00011400
+#define YAMUNA_UART2_ADDR               0x00011500
+#define YAMUNA_UART_INPUT_FREQ          50000000
+#define YAMUNA_UART_BAUDRATE            115200
+
+/* Derived Addresses (These typically don't need changes) */
+#define YAMUNA_ACLINT_MSWI_ADDR         (YAMUNA_CLINT_ADDR + CLINT_MSWI_OFFSET)
+#define YAMUNA_ACLINT_MTIMER_ADDR       (YAMUNA_CLINT_ADDR + CLINT_MTIMER_OFFSET)
+
+/* If you later enable PLIC, you can use this (example).
+ * Make sure plic.h is included.
+ */
+/*
+static struct plic_data plic = {
+	.addr = YAMUNA_PLIC_ADDR,
+	.size = YAMUNA_PLIC_SIZE,
+	.num_src = YAMUNA_PLIC_NUM_SOURCES,
+	.context_map = {
+		[0] = { 0, 1 },
+	},
+};
+*/
+
+static struct aclint_mswi_data mswi = {
+	.addr = YAMUNA_ACLINT_MSWI_ADDR,
+	.size = ACLINT_MSWI_SIZE,
+	.first_hartid = 0,
+	.hart_count = YAMUNA_HART_COUNT,
+};
+
+static struct aclint_mtimer_data mtimer = {
+	.mtime_freq = YAMUNA_ACLINT_MTIMER_FREQ,
+	.mtime_addr = YAMUNA_ACLINT_MTIMER_ADDR +
+		      ACLINT_DEFAULT_MTIME_OFFSET,
+	.mtime_size = ACLINT_DEFAULT_MTIME_SIZE,
+	.mtimecmp_addr = YAMUNA_ACLINT_MTIMER_ADDR +
+			 ACLINT_DEFAULT_MTIMECMP_OFFSET,
+	.mtimecmp_size = ACLINT_DEFAULT_MTIMECMP_SIZE,
+	.first_hartid = 0,
+	.hart_count = YAMUNA_HART_COUNT,
+	.has_64bit_mmio = true,
+};
+
+/*
+ * Platform early initialization.
+ * For OpenSBI v1.8, do cold-boot init for UART + ACLINT here.
+ */
+static int yamuna_early_init(bool cold_boot)
+{
+	int rc;
+
+	if (!cold_boot)
+		return 0;
+
+	/* UART console */
+	rc = shakti_uart_init(YAMUNA_UART0_ADDR,
+			      YAMUNA_UART_INPUT_FREQ,
+			      YAMUNA_UART_BAUDRATE);
+	if (rc)
+		return rc;
+
+	/* IPI + timer init (OpenSBI v1.8 style: init here, not via ops fields) */
+	(void)aclint_mswi_cold_init(&mswi);
+	(void)aclint_mtimer_cold_init(&mtimer, NULL);
+
+	return 0;
+}
+
+/*
+ * Platform final initialization.
+ */
+static int yamuna_final_init(bool cold_boot)
+{
+	(void)cold_boot;
+	return 0;
+}
+
+/* If you later enable PLIC, uncomment and add .irqchip_init in platform_ops */
+/*
+static int yamuna_irqchip_init(bool cold_boot)
+{
+	if (!cold_boot)
+		return 0;
+	return plic_cold_irqchip_init(&plic);
+}
+*/
+
+/*
+ * Platform descriptor (OpenSBI v1.8 compatible)
+ */
+const struct sbi_platform_operations platform_ops = {
+	.early_init = yamuna_early_init,
+	.final_init = yamuna_final_init,
+	/* .irqchip_init = yamuna_irqchip_init, */
+};
+
+const struct sbi_platform platform = {
+	.opensbi_version	= OPENSBI_VERSION,
+	.platform_version	= SBI_PLATFORM_VERSION(0x0, 0x01),
+	.name			= "C-Class Yamuna",
+	.features		= SBI_PLATFORM_DEFAULT_FEATURES,
+	.hart_count		= YAMUNA_HART_COUNT,
+	.hart_stack_size	= SBI_PLATFORM_DEFAULT_HART_STACK_SIZE,
+	.heap_size		= SBI_PLATFORM_DEFAULT_HEAP_SIZE(YAMUNA_HART_COUNT),
+	.platform_ops_addr	= (unsigned long)&platform_ops,
+};
+
