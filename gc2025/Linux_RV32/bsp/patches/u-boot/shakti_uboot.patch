diff --git a/configs/shakti_arty100_defconfig b/configs/shakti_arty100_defconfig
new file mode 100644
index 00000000000..0ba30e58753
--- /dev/null
+++ b/configs/shakti_arty100_defconfig
@@ -0,0 +1,85 @@
+CONFIG_RISCV=y
+CONFIG_64BIT=y
+CONFIG_TARGET_SHAKTI_ARTY100=y
+CONFIG_RISCV_SMODE=y
+CONFIG_DISTRO_DEFAULTS=y
+
+# Toolchain/ISA safety (prevents zicsr/zifencei errors on older toolchains)
+# (Enable if available in your U-Boot; harmless otherwise)
+# CONFIG_RISCV_ISA_ZICSR=y
+# CONFIG_RISCV_ISA_ZIFENCEI=y
+
+# Early malloc (for DM before relocation)
+CONFIG_SYS_MALLOC_F_LEN=0x3000
+CONFIG_SYS_RELOC_GD_ENV_ADDR=y
+CONFIG_NR_DRAM_BANKS=1
+
+# Console / UART
+CONFIG_BAUDRATE=19200
+CONFIG_DM_SERIAL=y
+CONFIG_SERIAL=y
+CONFIG_SHAKTI_SERIAL=y
+
+# Early debug UART (set base/clock; matches your UART0 @ 0x11300)
+CONFIG_DEBUG_UART=y
+CONFIG_DEBUG_UART_SHAKTI=y
+CONFIG_DEBUG_UART_BASE=0x00011300
+CONFIG_DEBUG_UART_CLOCK=50000000
+
+# SPI bus + MMC-over-SPI
+CONFIG_SPI=y
+CONFIG_DM_SPI=y
+CONFIG_SHAKTI_SPI=y
+CONFIG_MMC=y
+CONFIG_MMC_SPI=y
+CONFIG_CMD_MMC=y
+
+# We are NOT using SPI NOR flash; disable these to shrink SPL unless you truly need them
+# (Leave commented if you really load from SPI-NOR)
+# CONFIG_SPL_SPI_FLASH_SUPPORT is not set
+
+# SPL (only keep what you actually need)
+CONFIG_SPL=y
+CONFIG_SPL_BUILD=y
+CONFIG_SPL_CLK=y
+CONFIG_SPL_DM_SPI=y
+CONFIG_SPL_MMC_SUPPORT=y
+# If your SPL loads a FIT/uImage from MMC, keep this address sane
+CONFIG_SPL_LOAD_FIT_ADDRESS=0x80000000
+
+# Images / compression
+CONFIG_GZIP=y
+# You boot a uImage with bootm; no need for BOOTZ here
+# CONFIG_CMD_BOOTZ is not set
+CONFIG_CMD_BOOTM=y
+
+# Partitioning + filesystems
+CONFIG_CMD_PART=y
+CONFIG_PARTITION_UUIDS=y
+CONFIG_EFI_PARTITION=y
+CONFIG_CMD_GPT=y
+CONFIG_CMD_FS_GENERIC=y
+CONFIG_FS_FAT=y
+CONFIG_FS_EXT4=y
+
+# Device Tree
+CONFIG_OF_CONTROL=y
+CONFIG_DEFAULT_DEVICE_TREE="shakti-arty100"
+CONFIG_CMD_FDT=y
+
+# Environment (size as you had)
+CONFIG_ENV_SIZE=0x20000
+
+# Prompt, delay
+CONFIG_SYS_PROMPT="Shakti U-Boot> "
+CONFIG_BOOTDELAY=5
+
+# Bootargs: you are using a UART console, not virtio; use ttyS0 at 19200
+# If your Linux driver registers a different tty name, change accordingly.
+CONFIG_USE_BOOTARGS=y
+CONFIG_BOOTARGS="console=ttyS0,19200 root=/dev/mmcblk0p1 rw rootfstype=ext4 selinux=0"
+
+# Bootcmd: load FDT + uImage from MMC:1 and bootm
+# Ensure these env vars exist at runtime (kernel_addr_r/fdt_addr_r).
+CONFIG_BOOTCOMMAND="mmc dev 0; mmc rescan; load mmc 0:1 \${fdt_addr_r} /boot/shakti_100t.dtb; fdt addr \${fdt_addr_r}; load mmc 0:1 \${kernel_addr_r} /boot/uImage; bootm \${kernel_addr_r} - \${fdt_addr_r}"
+
