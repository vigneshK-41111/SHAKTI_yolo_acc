+CONFIG_OF_EMBED=y
+
+# Serial (your custom UART)
+CONFIG_BAUDRATE=19200
+CONFIG_SHAKTI_SERIAL=y
+
+# Driver Model core
+CONFIG_DM=y
+CONFIG_BOARD_EARLY_INIT_F=y
+# SPI + DM SPI + our SSPI controller
+CONFIG_SPI=y
+CONFIG_DM_SPI=y
+CONFIG_SHAKTI_SPI=y
+
+# MMC over SPI to access SD card
+CONFIG_MMC=y
+CONFIG_MMC_SPI=y
+CONFIG_CMD_MMC=y
+
+# Useful filesystem/load commands to fetch kernel/DTB from SD
+CONFIG_CMD_FS_GENERIC=y
+CONFIG_CMD_FAT=y
+CONFIG_CMD_EXT4=y
+CONFIG_FS_FAT=y
+CONFIG_FS_EXT4=y
+
