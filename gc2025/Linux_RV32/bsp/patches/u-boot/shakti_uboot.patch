diff --git a/board/shakti/nexys_video/nexys_video.c b/board/shakti/nexys_video/nexys_video.c
new file mode 100644
index 00000000000..7f3bfd0adf9
--- /dev/null
+++ b/board/shakti/nexys_video/nexys_video.c
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0+
+// board/shakti/nexys_video/nexys_video.c
+//
+// Minimal board init for Shakti SoS C-Class on Nexys Video.
+//
+// IMPORTANT:
+//   Your FPGA bitstream maps SPI0 to the PMOD pins (spi0_mosi/miso/sclk/nss).
+//   Old code forced io17..io20 -> SPI1 via a hardcoded pinmux write,
+//   which breaks SPI0 on the PMOD and makes "mmc rescan" hang.
+//
+//   This file deliberately avoids any pinmux writes so the bitstream's
+//   default routing (SPI0) remains active.
+
+#include <init.h>
+
+int board_early_init_f(void)
+{
+	/* Do NOT touch pinmux: the bitstream already routes SPI0 to PMOD */
+	return 0;
+}
+
+int board_init(void)
+{
+	/* Nothing to re-apply after relocation */
+	return 0;
+}
+
+int board_late_init(void)
+{
+	return 0;
+}
+
diff --git a/board/shakti/yamuna/Kconfig b/board/shakti/yamuna/Kconfig
new file mode 100644
index 00000000000..755a5e2383f
--- /dev/null
+++ b/board/shakti/yamuna/Kconfig
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: GPL-2.0+
+if TARGET_SHAKTI_YAMUNA
+
+config SYS_BOARD
+    string
+    default "yamuna"
+
+config SYS_VENDOR
+    string
+    default "shakti"
+
+config SYS_CPU
+    string
+    default "generic"
+
+config SYS_CONFIG_NAME
+    string
+    default "shakti_yamuna"
+
+# U-Boot proper runs as S-mode payload at 0x80200000 under OpenSBI
+config SYS_TEXT_BASE
+    hex
+    default 0x80200000
+
+config SYS_UBOOT_START
+    hex
+    default 0x80200000
+
+# Optional SPL values (harmless if not used)
+config SPL_TEXT_BASE
+    hex
+    default 0x08000000
+
+config SPL_OPENSBI_LOAD_ADDR
+    hex
+    default 0x80000000
+
+config SYS_LOAD_ADDR
+    hex
+    default 0x80200000
+
+config BOARD_SPECIFIC_OPTIONS
+    def_bool y
+    select GENERIC_RISCV
+    select RAM
+    imply DISTRO_DEFAULTS
+    imply DM
+    imply OF_CONTROL
+    imply SPI
+    imply DM_SPI
+    imply EFI_PARTITION
+    imply CMD_GPT
+    imply CMD_FS_GENERIC
+    imply FS_FAT
+    imply FS_EXT4
+    imply RISCV_SMODE   # U-Boot is S-mode payload under OpenSBI
+    imply ARCH_RV32I    # Yamuna is RV32
+    imply RISCV_ISA_C
+    imply RISCV_ISA_A
+
+endif
+
