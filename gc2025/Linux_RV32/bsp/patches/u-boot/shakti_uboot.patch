diff --git a/drivers/serial/serial_shakti.c b/drivers/serial/serial_shakti.c
new file mode 100644
index 00000000000..8a3ea3fd694
--- /dev/null
+++ b/drivers/serial/serial_shakti.c
@@ -0,0 +1,179 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Shakti SoS UART driver (MMIO, 8/16-bit registers)
+ * - TX/RX via 8-bit access (readb/writeb)
+ * - STATUS/BAUD via 16-bit access (readw/writew)
+ * - DEBUG_UART honors SKIP_INIT to avoid early MMIO writes
+ */
+#include <init.h>
+#include <dm.h>
+#include <dm/read.h>
+#include <clk.h>
+#include <serial.h>
+#include <asm/io.h>
+
+#define REG_BAUD            0x00
+#define REG_TX              0x04
+#define REG_RX              0x08
+#define REG_STATUS          0x0C
+/* (add others if you need them later) */
+
+#define STS_TX_EMPTY        (1U << 0)
+#define STS_TX_FULL         (1U << 1)
+#define STS_RX_NOT_EMPTY    (1U << 2)
+
+#define DEF_CLK             50000000U
+
+struct shakti_uart_plat {
+	u8 __iomem  *base;     /* byte pointer for safe offset math */
+	struct clk    clk;
+	u32          clock;
+	bool         clk_valid;
+};
+
+/* --- helpers: correct widths --- */
+static inline u8  rd8 (struct shakti_uart_plat *p, u32 off) { return  readb(p->base + off); }
+static inline void wr8 (struct shakti_uart_plat *p, u32 off, u8 v) { writeb(v, p->base + off); }
+static inline u16 rd16(struct shakti_uart_plat *p, u32 off) { return  readw(p->base + off); }
+static inline void wr16(struct shakti_uart_plat *p, u32 off, u16 v) { writew(v, p->base + off); }
+
+static int set_div(struct shakti_uart_plat *p, int baud)
+{
+	/* BAUD is 16-bit: div = round(clock / (16*baud)) */
+	u64 num = p->clock ? p->clock : DEF_CLK;
+	u64 den = 16ULL * (u64)baud;
+	u32 div = (u32)((num + (den / 2)) / den);
+
+	if (!div) div = 1;
+	if (div > 0xFFFF) div = 0xFFFF;
+	wr16(p, REG_BAUD, (u16)div);
+	return 0;
+}
+
+static int shakti_setbrg(struct udevice *dev, int baud)
+{
+	return set_div(dev_get_plat(dev), baud);
+}
+
+static int shakti_getc(struct udevice *dev)
+{
+	struct shakti_uart_plat *p = dev_get_plat(dev);
+
+	/* blocking read (U-Boot's serial ops expect this) */
+	while (!(rd16(p, REG_STATUS) & STS_RX_NOT_EMPTY))
+		;
+	return rd8(p, REG_RX); /* return 0..255 */
+}
+
+static int shakti_putc(struct udevice *dev, const char ch)
+{
+	struct shakti_uart_plat *p = dev_get_plat(dev);
+
+	/* send CR before LF for nicer terminals */
+	if (ch == '\n') {
+		while (rd16(p, REG_STATUS) & STS_TX_FULL)
+			;
+		wr8(p, REG_TX, '\r');
+	}
+
+	while (rd16(p, REG_STATUS) & STS_TX_FULL)
+		;
+	wr8(p, REG_TX, (u8)ch);
+	return 0;
+}
+
+static int shakti_pending(struct udevice *dev, bool input)
+{
+	struct shakti_uart_plat *p = dev_get_plat(dev);
+	u16 st = rd16(p, REG_STATUS);
+
+	/* return >0 if something pending */
+	return input ? !!(st & STS_RX_NOT_EMPTY) : !(st & STS_TX_FULL);
+}
+
+static int shakti_probe(struct udevice *dev)
+{
+	struct shakti_uart_plat *p = dev_get_plat(dev);
+
+	if (p->clk_valid)
+		clk_enable(&p->clk);
+	return set_div(p, gd->baudrate);
+}
+
+static int shakti_of_to_plat(struct udevice *dev)
+{
+	struct shakti_uart_plat *p = dev_get_plat(dev);
+	u32 hz = 0;
+
+	fdt_addr_t addr = dev_read_addr(dev);
+	if (addr == FDT_ADDR_T_NONE)
+		return -EINVAL;
+
+	p->base = (u8 __iomem *)(uintptr_t)addr;
+
+	if (!clk_get_by_index(dev, 0, &p->clk)) {
+		long r = clk_get_rate(&p->clk);
+		if (r > 0) {
+			p->clock = (u32)r;
+			p->clk_valid = true;
+		}
+	}
+	if (!p->clock && !dev_read_u32(dev, "clock-frequency", &hz))
+		p->clock = hz;
+	if (!p->clock)
+		p->clock = DEF_CLK;
+
+	return 0;
+}
+
+static const struct dm_serial_ops shakti_ops = {
+	.putc    = shakti_putc,
+	.getc    = shakti_getc,
+	.pending = shakti_pending,
+	.setbrg  = shakti_setbrg,
+};
+
+static const struct udevice_id shakti_ids[] = {
+	{ .compatible = "shakti,uart0" },
+	{ }
+};
+
+U_BOOT_DRIVER(serial_shakti) = {
+	.name           = "serial_shakti",
+	.id             = UCLASS_SERIAL,
+	.of_match       = shakti_ids,
+	.of_to_plat     = shakti_of_to_plat,
+	.plat_auto      = sizeof(struct shakti_uart_plat),
+	.probe          = shakti_probe,
+	.ops            = &shakti_ops,
+};
+
+#ifdef CONFIG_DEBUG_UART_SHAKTI
+/* ---- DEBUG UART (very early) ---- */
+static struct shakti_uart_plat dbg;
+
+static inline void _debug_uart_init(void)
+{
+	dbg.base  = (u8 __iomem *)CONFIG_DEBUG_UART_BASE;
+	dbg.clock = CONFIG_DEBUG_UART_CLOCK;
+
+#if !CONFIG_IS_ENABLED(DEBUG_UART_SKIP_INIT)
+	set_div(&dbg, CONFIG_BAUDRATE);
+#endif
+}
+
+static inline void _debug_uart_putc(int ch)
+{
+	/* CR before LF */
+	if (ch == '\n') {
+		while (rd16(&dbg, REG_STATUS) & STS_TX_FULL)
+			;
+		wr8(&dbg, REG_TX, '\r');
+	}
+	while (rd16(&dbg, REG_STATUS) & STS_TX_FULL)
+		;
+	wr8(&dbg, REG_TX, (u8)ch);
+}
+DEBUG_UART_FUNCS
+#endif
+
