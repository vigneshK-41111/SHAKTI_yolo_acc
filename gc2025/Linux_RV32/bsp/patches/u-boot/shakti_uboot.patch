diff --git a/arch/riscv/dts/shakti_nexys_video.dts b/arch/riscv/dts/shakti_nexys_video.dts
new file mode 100644
index 00000000000..054526f3abe
--- /dev/null
+++ b/arch/riscv/dts/shakti_nexys_video.dts
@@ -0,0 +1,100 @@
+/dts-v1/;
+/ {
+    #address-cells = <2>;
+    #size-cells = <2>;
+    compatible = "shakti,sos-nexys-video";
+    model = "Shakti SoS C-Class on Nexys Video";
+
+    aliases {
+        serial0 = &uart0;
+    };
+
+    chosen {
+        stdout-path = &uart0;
+        bootargs = "";
+    };
+
+    cpus {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        timebase-frequency = <0x8000>;   /* 10 MHz mtimer */
+        cpu0: cpu@0 {
+            device_type = "cpu";
+            compatible = "riscv";
+            reg = <0x00>;
+            status = "okay";
+            riscv,isa = "rv64imac";
+            mmu-type = "riscv,sv39";
+            clock-frequency = <40000000>; /* 40 MHz core */
+
+            interrupt-controller {
+                #interrupt-cells = <1>;
+                interrupt-controller;
+                compatible = "riscv,cpu-intc";
+                phandle = <1>;
+            };
+        };
+    };
+
+    memory@80000000 {
+        device_type = "memory";
+        reg = <0x0 0x80000000 0x0 0x20000000>; /* 512 MiB */
+    };
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+        compatible = "shakti,sos-soc", "simple-bus";
+        ranges;
+
+        clint@2000000 {
+            compatible = "riscv,clint0";
+            reg = <0x0 0x02000000 0x0 0x000c0000>;
+            interrupts-extended = <0x0 0x2000000 0x07>;
+        };
+
+        interrupt-controller@c000000 {
+            #interrupt-cells = <2>;
+            compatible = "riscv,plic0";
+            interrupt-controller;
+            reg = <0x0 0xc000000 0x0 0x4000000>;
+            interrupts-extended = <0x1 0x0b 0x01 0x09>;
+            reg-names = "control";
+            riscv,max-priority = <7>;
+            riscv,ndev = <29>;
+            phandle = <2>;
+        };
+
+       osc: oscillator {
+            compatible = "fixed-clock";
+            #clock-cells = <0>;
+            clock-frequency = <40000000>; /* 40 MHz reference */
+        };
+
+        uart0: uart@11300 {
+            compatible = "shakti,uart0";
+            reg = <0x0 0x00011300 0x0 0x100>;
+            clock-frequency = <40000000>;
+            current-speed = <115200>;
+        };
+
+        spi@20100 {
+            compatible = "shakti,spi1";
+            reg = <0x0 0x20100 0x0 0x100>;
+            clocks = <&osc>;
+            shakti,spi-frequency = <2000000>;     /* 2 MHz init */
+            shakti,lsb-first = <0>;
+            shakti,communication-mode = <3>;
+            shakti,fifo-depth = <31>;
+
+            mmc-slot@0 {
+                compatible = "mmc-spi-slot";
+                reg = <0>;                          /* CS0 */
+                voltage-ranges = <3300 3300>;
+                spi-max-frequency = <20000000>;     /* 20 MHz */
+                broken-cd;
+            };
+        };
+    };
+};
+
diff --git a/arch/riscv/dts/shakti_yamuna.dts b/arch/riscv/dts/shakti_yamuna.dts
new file mode 100644
index 00000000000..64cc2192c3f
--- /dev/null
+++ b/arch/riscv/dts/shakti_yamuna.dts
@@ -0,0 +1,131 @@
+/dts-v1/;
+/ {
+    #address-cells = <1>;
+    #size-cells = <1>;
+    compatible = "shakti,yamuna", "shakti,sos-soc";
+    model = "Shakti SoS C-Class (Yamuna)";
+    interrupt-parent = <&plic>;
+
+    /* ===== Aliases and chosen ===== */
+    aliases {
+        serial0 = &uart0;
+    };
+
+    chosen {
+        stdout-path = &uart0;
+        bootargs = "";
+    };
+
+    /* ===== CPU and timebase info ===== */
+    cpus {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        timebase-frequency = <97656>; /* 10 MHz mtimer (matches OpenSBI) */
+
+        cpu0: cpu@0 {
+            device_type = "cpu";
+            reg = <0>;
+            compatible = "riscv";
+            riscv,isa = "rv32imac";
+            mmu-type = "riscv,sv32";
+            status = "okay";
+
+            cpu0_intc: interrupt-controller {
+                compatible = "riscv,cpu-intc";
+                interrupt-controller;
+                #interrupt-cells = <1>;
+            };
+        };
+    };
+
+    /* ===== System memory ===== */
+/* ===== System memory ===== */
+memory@80000000 {
+    device_type = "memory";
+    reg = <0x80000000 0x10000000>; /* 256 MB SDRAM starting at 0x80000000 */
+};
+    /* ===== SoC peripherals ===== */
+    soc {
+        compatible = "simple-bus";
+        #address-cells = <1>;
+        #size-cells = <1>;
+        ranges;
+
+        /* CLINT: Core Local Interruptor (msip, mtime, mtimecmp) */
+        clint@2000000 {
+            compatible = "riscv,clint0";
+            reg = <0x02000000 0x000c0000>;
+        };
+
+        /* PLIC: Platform-Level Interrupt Controller */
+        plic: interrupt-controller@c000000 {
+            compatible = "riscv,plic0";
+            reg = <0x0c000000 0x04000000>;
+            interrupt-controller;
+            #interrupt-cells = <1>;
+            riscv,max-priority = <7>;
+            riscv,ndev = <64>;
+        };
+
+        /* 50 MHz reference oscillator (adjust if 40 MHz in FPGA bitstream) */
+        osc: oscillator {
+            compatible = "fixed-clock";
+            #clock-cells = <0>;
+            clock-frequency = <50000000>;
+        };
+
+        /* UART0 console (base: 0x00011300, size: 0x100) */
+        uart0: serial@11300 {
+            compatible = "shakti,uart0";
+            reg = <0x00011300 0x00000100>;
+            clocks = <&osc>;
+            clock-names = "uartclk";
+            clock-frequency = <50000000>;
+            status = "okay";
+        };
+
+        /* Additional UARTs — optional for later enablement */
+        uart1: serial@11400 {
+            compatible = "shakti,uart1";
+            reg = <0x00011400 0x00000100>;
+            clocks = <&osc>;
+            clock-names = "uartclk";
+            clock-frequency = <50000000>;
+            status = "disabled";
+        };
+
+        uart2: serial@11500 {
+            compatible = "shakti,uart2";
+            reg = <0x00011500 0x00000100>;
+            clocks = <&osc>;
+            clock-names = "uartclk";
+            clock-frequency = <50000000>;
+            status = "disabled";
+        };
+
+        spi@20100 {
+            compatible = "shakti,spi1";
+            reg = <0x0020100 0x00000100>;    /* base 0x20100, size 0x100 */
+            clocks = <&osc>;                 /* use fixed-clock 'osc' defined above */
+            shakti,controller = <0x00000001>;
+            shakti,spi-frequency = <0x001E8480>; /* 2,000,000 (2 MHz) */
+            shakti,lsb-first = <0x00000000>;
+            shakti,communication-mode = <0x00000003>;
+            shakti,cpha = <0x00000000>;
+            shakti,cpol = <0x00000000>;
+            shakti,cs-high = <0x00000001>;
+            shakti,fifo-size = <0x0000001f>; /* was fifo-depth; driver expects fifo-size */
+            status = "okay";
+
+            mmc-slot@0 {
+                compatible = "mmc-spi-slot";
+                reg = <0x00000000>;
+                voltage-ranges = <0x00000ce4 0x00000ce4>;
+                spi-max-frequency = <0x002625a0>; /* 2,500,000 (2.5 MHz) */
+                status = "okay";
+            };
+        };
+
+    };
+};
+
diff --git a/board/shakti/nexys_video/Kconfig b/board/shakti/nexys_video/Kconfig
new file mode 100644
index 00000000000..52e62d94eb4
--- /dev/null
+++ b/board/shakti/nexys_video/Kconfig
@@ -0,0 +1,72 @@
+# SPDX-License-Identifier: GPL-2.0+
+
+if TARGET_SHAKTI_NEXYS_VIDEO
+
+config SYS_BOARD
+	string
+	default "nexys_video"
+
+config SYS_VENDOR
+	string
+	default "shakti"
+
+config SYS_CPU
+	string
+	default "generic"
+
+config SYS_CONFIG_NAME
+	string
+	default "shakti_nexys_video"
+
+# U-Boot proper link base
+config SYS_TEXT_BASE
+	hex
+	default 0x80200000 if SPL
+	default 0x80000000 if !RISCV_SMODE
+	default 0x80200000 if RISCV_SMODE
+
+# Some U-Boot versions still expect TEXT_BASE; set it explicitly
+config TEXT_BASE
+	hex
+	default 0x80200000 if RISCV_SMODE
+	default 0x80000000 if !RISCV_SMODE
+
+# Entry point for U-Boot
+config SYS_UBOOT_START
+	hex
+	default 0x80200000 if RISCV_SMODE
+	default 0x80000000 if !RISCV_SMODE
+
+# SPL (harmless if SPL=n; keeps future path ready)
+config SPL_TEXT_BASE
+	hex
+	default 0x08000000
+
+config SPL_OPENSBI_LOAD_ADDR
+	hex
+	default 0x80000000
+
+# Default load address for ‘load’/tftpboot/etc.
+config SYS_LOAD_ADDR
+	hex
+	default 0x80200000
+
+config BOARD_SPECIFIC_OPTIONS
+	def_bool y
+	select GENERIC_RISCV
+	select RAM
+	imply RISCV_SMODE
+	imply DISTRO_DEFAULTS
+	imply DM
+	imply OF_CONTROL
+	imply SPI
+	imply DM_SPI
+	imply MMC
+	imply EFI_PARTITION
+	imply CMD_GPT
+	imply CMD_FS_GENERIC
+	imply FS_FAT
+	imply FS_EXT4
+
+endif
+
