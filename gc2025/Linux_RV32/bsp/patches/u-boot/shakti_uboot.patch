diff --git a/drivers/spi/spi-shakti.c b/drivers/spi/spi-shakti.c
new file mode 100644
index 00000000000..8d654324501
--- /dev/null
+++ b/drivers/spi/spi-shakti.c
@@ -0,0 +1,399 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Shakti SPI controller driver (master mode only)
+ */
+#include <dm.h>
+#include <dm/device_compat.h>
+#include <malloc.h>
+#include <spi.h>
+#include <spi-mem.h>
+#include <wait_bit.h>
+#include <asm/io.h>
+#include <linux/bitops.h>
+#include <linux/log2.h>
+#include <clk.h>
+
+/* #define SHAKTI_DEBUG */
+
+/* Controller registers and constants */
+#define SHAKTI_SPI_COMM_CTRL_REG            0x00
+#define SHAKTI_SPI_CLK_CTRL_REG             0x04
+#define SHAKTI_SPI_TX_DATA                  0x08
+#define SHAKTI_SPI_RX_DATA                  0x0C
+#define SHAKTI_SPI_INTR_EN                  0x10
+#define SHAKTI_SPI_FIFO_STATUS              0x14
+#define SHAKTI_SPI_COMM_STATUS              0x18
+#define SHAKTI_SPI_QUAD                     0x1C
+
+/* COMM CTRL bits */
+#define SHAKTI_SPI_MASTER                   (1 << 0)
+#define SHAKTI_SPI_ENABLE_BIT               (1 << 1)
+#define SHAKTI_SPI_LSB_FIRST                (1 << 2)
+#define SHAKTI_SPI_COMM_MODE(x)             ((x) << 4)
+#define SHAKTI_SPI_TOTAL_BITS_TX(x)         ((x) << 6)
+#define SHAKTI_SPI_TOTAL_BITS_RX(x)         ((x) << 14)
+#define SHAKTI_SPI_OUT_EN_SCLK              (1 << 22)
+#define SHAKTI_SPI_OUT_EN_NCS               (1 << 23)
+#define SHAKTI_SPI_OUT_EN_MISO              (1 << 24)
+#define SHAKTI_SPI_OUT_EN_MOSI              (1 << 25)
+
+/* CLK CTRL bits */
+#define SHAKTI_SPI_CLK_POLARITY             (1 << 0)
+#define SHAKTI_SPI_CLK_PHASE                (1 << 1)
+#define SHAKTI_SPI_PRESCALE(x)              ((x) << 2)
+
+/* STATUS bits */
+#define SHAKTI_SPI_BUSY                     (1 << 0)
+
+/* FIFO bits (simple use) */
+#define SHAKTI_SPI_TX_EMPTY                 (1 << 0)
+#define SHAKTI_SPI_RX_EMPTY                 (1 << 4)
+
+/* Modes and defaults */
+#define SHAKTI_SPI_SIMPLEX_TX               0
+#define SHAKTI_SPI_SIMPLEX_RX               1
+#define SHAKTI_SPI_HALF_DUPLEX              2
+#define SHAKTI_SPI_FULL_DUPLEX              3
+
+#define SHAKTI_SPI_DEFAULT_DEPTH            16
+#define SHAKTI_SPI_DEFAULT_SPEED            2000000
+
+/* Temporary fixed pinmux address (replace with DT/syscon) */
+#define PINMUX_CONFIGURE_REG                0x41510
+#define SHAKTI_SPI_PINMUX_MASK              0xFFC03FFF
+#define SHAKTI_SPI_PINMUX_SET               0x00154000
+
+struct shakti_spi {
+        void __iomem *base;
+        struct clk clk;
+        u32 fifo_depth;
+        u32 bits_per_word;
+        u32 base_freq;
+        u32 op_freq;
+        u32 cur_mode;
+        u32 cur_xferlen;
+        u32 cur_bpw;
+        u8  prescalar;
+        u8  lsb_first_en;
+        unsigned int tx_len;
+        unsigned int rx_len;
+        const void *tx_buf;
+        void *rx_buf;
+        bool cs_high;
+};
+
+/* Forward decl */
+static void shakti_lsb_first(struct shakti_spi *spi);
+
+/* IO helpers */
+static inline u8 shakti_spi_read8(struct shakti_spi *spi, u32 off)
+{
+        return readb(spi->base + off);
+}
+static inline u32 shakti_spi_read32(struct shakti_spi *spi, u32 off)
+{
+        return readl(spi->base + off);
+}
+static inline void shakti_spi_set32(struct shakti_spi *spi, u32 off, u32 bits)
+{
+        writel(readl(spi->base + off) | bits, spi->base + off);
+}
+static inline void shakti_spi_clr32(struct shakti_spi *spi, u32 off, u32 bits)
+{
+        writel(readl(spi->base + off) & ~bits, spi->base + off);
+}
+
+static int shakti_spi_set_mode(struct udevice *bus, uint mode)
+{
+        struct shakti_spi *spi = dev_get_priv(bus);
+        u32 clk_mode = 0;
+
+        if (mode & SPI_CPOL)
+                clk_mode |= SHAKTI_SPI_CLK_POLARITY;
+        if (mode & SPI_CPHA)
+                clk_mode |= SHAKTI_SPI_CLK_PHASE;
+
+        spi->lsb_first_en = (mode & SPI_LSB_FIRST) ? 1 : 0;
+        spi->cs_high = !!(mode & SPI_CS_HIGH);
+
+        shakti_lsb_first(spi);
+
+        u32 temp = readl(spi->base + SHAKTI_SPI_CLK_CTRL_REG) &
+                   ~(SHAKTI_SPI_CLK_POLARITY | SHAKTI_SPI_CLK_PHASE);
+        writel(temp | clk_mode, spi->base + SHAKTI_SPI_CLK_CTRL_REG);
+
+        return 0;
+}
+
+static int shakti_spi_set_speed(struct udevice *bus, uint speed)
+{
+        struct shakti_spi *spi = dev_get_priv(bus);
+
+        if (spi->op_freq == speed)
+                return 0;
+
+        if (!speed || !spi->base_freq || speed > spi->base_freq)
+                return -EINVAL;
+
+        /* prescaler = (base / target) - 1 */
+        u32 div = spi->base_freq / speed;
+        if (div == 0)
+                div = 1;   /* avoid divide-by-zero */
+        u8 presc = (u8)(div - 1);
+
+        /* hardware prescaler is only 8-bit */
+        if (presc > 255)
+                return -EINVAL;
+
+        u32 temp = readl(spi->base + SHAKTI_SPI_CLK_CTRL_REG) &
+                   ~SHAKTI_SPI_PRESCALE(0xFF);
+        writel(temp | SHAKTI_SPI_PRESCALE(presc),
+               spi->base + SHAKTI_SPI_CLK_CTRL_REG);
+
+        spi->op_freq = spi->base_freq / (presc + 1);
+        return 0;
+}
+
+static void shakti_spi_tx(struct shakti_spi *spi, const u8 *tx_ptr)
+{
+        writeb(*tx_ptr, spi->base + SHAKTI_SPI_TX_DATA);
+}
+static void shakti_spi_rx(struct shakti_spi *spi, u8 *rx_ptr)
+{
+        *rx_ptr = readb(spi->base + SHAKTI_SPI_RX_DATA);
+}
+static void shakti_spi_busy(struct shakti_spi *spi)
+{
+        u8 s;
+        do {
+                s = shakti_spi_read8(spi, SHAKTI_SPI_COMM_STATUS);
+        } while (s & SHAKTI_SPI_BUSY);
+}
+
+static int shakti_spi_xfer(struct udevice *dev, unsigned int bitlen,
+                           const void *dout, void *din, unsigned long flags)
+{
+        struct shakti_spi *spi = dev_get_priv(dev->parent);
+        unsigned int xferlen = bitlen / 8;
+        int r_words = xferlen;
+
+        spi->tx_buf = dout;
+        spi->rx_buf = din;
+        spi->tx_len = spi->tx_buf ? xferlen : 0;
+        spi->rx_len = spi->rx_buf ? xferlen : 0;
+
+        u8 dummy_tx = 0xFF;
+
+        u32 mode = SHAKTI_SPI_FULL_DUPLEX;
+        if (!spi->tx_buf)
+                mode = SHAKTI_SPI_SIMPLEX_RX;
+        else if (!spi->rx_buf)
+                mode = SHAKTI_SPI_SIMPLEX_TX;
+
+        if (spi->cur_mode != mode) {
+                shakti_spi_clr32(spi, SHAKTI_SPI_COMM_CTRL_REG,
+                                 SHAKTI_SPI_COMM_MODE(3));
+                spi->cur_mode = mode;
+                shakti_spi_set32(spi, SHAKTI_SPI_COMM_CTRL_REG,
+                                 SHAKTI_SPI_COMM_MODE(spi->cur_mode));
+        }
+
+        while (r_words) {
+                unsigned int fifo = (unsigned int)spi->fifo_depth;
+                unsigned int n_words = min(r_words, fifo);
+
+                shakti_spi_clr32(spi, SHAKTI_SPI_COMM_CTRL_REG,
+                                 SHAKTI_SPI_TOTAL_BITS_RX(255));
+                shakti_spi_clr32(spi, SHAKTI_SPI_COMM_CTRL_REG,
+                                 SHAKTI_SPI_TOTAL_BITS_TX(255));
+
+                if (spi->cur_mode == SHAKTI_SPI_SIMPLEX_RX ||
+                    spi->cur_mode == SHAKTI_SPI_FULL_DUPLEX) {
+                        shakti_spi_set32(spi, SHAKTI_SPI_COMM_CTRL_REG,
+                                         SHAKTI_SPI_TOTAL_BITS_RX(n_words * 8));
+                }
+                shakti_spi_set32(spi, SHAKTI_SPI_COMM_CTRL_REG,
+                                 SHAKTI_SPI_TOTAL_BITS_TX(n_words * 8));
+
+                if (spi->tx_buf) {
+                        const u8 *tp = (const u8 *)spi->tx_buf;
+                        for (unsigned int i = 0; i < n_words; i++)
+                                shakti_spi_tx(spi, tp++);
+                        spi->tx_buf = tp;
+                } else {
+                        for (unsigned int i = 0; i < n_words; i++)
+                                shakti_spi_tx(spi, &dummy_tx);
+                }
+
+                shakti_spi_set32(spi, SHAKTI_SPI_COMM_CTRL_REG,
+                                 SHAKTI_SPI_ENABLE_BIT);
+
+                while (!(shakti_spi_read8(spi, SHAKTI_SPI_FIFO_STATUS) &
+                         SHAKTI_SPI_TX_EMPTY)) {
+                        /* wait */
+                }
+
+                shakti_spi_busy(spi);
+
+                if (spi->rx_buf) {
+                        u8 *rp = (u8 *)spi->rx_buf;
+                        unsigned int rx_cnt = n_words;
+                        while (!(shakti_spi_read8(spi, SHAKTI_SPI_FIFO_STATUS) &
+                                 SHAKTI_SPI_RX_EMPTY) && rx_cnt--)
+                                shakti_spi_rx(spi, rp++);
+                        spi->rx_buf = rp;
+                }
+
+                r_words -= n_words;
+        }
+
+        return 0;
+}
+
+static void shakti_spi_configure_pins(struct shakti_spi *spi,
+                                      uint8_t mosi_pin_cntrl,
+                                      uint8_t miso_pin_cntrl,
+                                      uint8_t cs_pin_cntrl,
+                                      uint8_t clk_pin_cntrl)
+{
+        uint32_t temp = 0;
+
+        if (mosi_pin_cntrl)
+                temp |= SHAKTI_SPI_OUT_EN_MOSI;
+        else
+                temp &= ~SHAKTI_SPI_OUT_EN_MOSI;
+
+        if (miso_pin_cntrl)
+                temp |= SHAKTI_SPI_OUT_EN_MISO;
+        else
+                temp &= ~SHAKTI_SPI_OUT_EN_MISO;
+
+        if (cs_pin_cntrl)
+                temp |= SHAKTI_SPI_OUT_EN_NCS;
+        else
+                temp &= ~SHAKTI_SPI_OUT_EN_NCS;
+
+        if (clk_pin_cntrl)
+                temp |= SHAKTI_SPI_OUT_EN_SCLK;
+        else
+                temp &= ~SHAKTI_SPI_OUT_EN_SCLK;
+
+        shakti_spi_set32(spi, SHAKTI_SPI_COMM_CTRL_REG, temp);
+}
+
+static void shakti_lsb_first(struct shakti_spi *spi)
+{
+        if (spi->lsb_first_en)
+                shakti_spi_set32(spi, SHAKTI_SPI_COMM_CTRL_REG,
+                                 SHAKTI_SPI_LSB_FIRST);
+        else
+                shakti_spi_clr32(spi, SHAKTI_SPI_COMM_CTRL_REG,
+                                 SHAKTI_SPI_LSB_FIRST);
+}
+
+static int shakti_spi_probe(struct udevice *bus)
+{
+        struct shakti_spi *spi = dev_get_priv(bus);
+        unsigned long clk_rate;
+        int ret;
+
+        spi->base = dev_remap_addr(bus);
+        if (!spi->base)
+                return -EINVAL;
+
+        /* TEMP: directly program pinmux (prefer DT/syscon long-term) */
+        void __iomem *pinmux_register =
+                (void __iomem *)(uintptr_t)PINMUX_CONFIGURE_REG;
+        u32 pinmux_reg_read = readl(pinmux_register) | SHAKTI_SPI_PINMUX_MASK;
+        writel(SHAKTI_SPI_PINMUX_SET | pinmux_reg_read, pinmux_register);
+
+        spi->fifo_depth = dev_read_u32_default(bus, "shakti,fifo-size", 0);
+        if (!spi->fifo_depth)
+                spi->fifo_depth = SHAKTI_SPI_DEFAULT_DEPTH;
+
+        spi->op_freq = dev_read_u32_default(bus, "shakti,spi-frequency", 0);
+        if (!spi->op_freq)
+                spi->op_freq = SHAKTI_SPI_DEFAULT_SPEED;
+
+        spi->lsb_first_en = dev_read_u32_default(bus, "shakti,lsb-first", 0) ? 1 : 0;
+
+        ret = clk_get_by_index(bus, 0, &spi->clk);
+        if (ret < 0)
+                return ret;
+        ret = clk_enable(&spi->clk);
+        if (ret < 0)
+                return ret;
+        clk_rate = clk_get_rate(&spi->clk);
+        if (!clk_rate) {
+                ret = -EINVAL;
+                goto clk_err;
+        }
+        spi->base_freq = clk_rate;
+
+        if (spi->op_freq > spi->base_freq) {
+                ret = -EINVAL;
+                goto clk_err;
+        }
+
+        spi->cur_mode = SHAKTI_SPI_FULL_DUPLEX;
+        spi->cur_xferlen = 0;
+        spi->cur_bpw = SPI_DEFAULT_WORDLEN;
+
+        /* Master mode, pins, bit order, duplex, prescale */
+        shakti_spi_set32(spi, SHAKTI_SPI_COMM_CTRL_REG, SHAKTI_SPI_MASTER);
+        shakti_spi_configure_pins(spi, 1, 0, 1, 1);
+        shakti_lsb_first(spi);
+
+        shakti_spi_set32(spi, SHAKTI_SPI_COMM_CTRL_REG,
+                         SHAKTI_SPI_COMM_MODE(spi->cur_mode));
+
+        {
+                u32 div = spi->base_freq / spi->op_freq;
+                if (div == 0)
+                        div = 1;
+                u8 presc = (u8)(div - 1);
+                u32 temp = readl(spi->base + SHAKTI_SPI_CLK_CTRL_REG) &
+                           ~SHAKTI_SPI_PRESCALE(0xFF);
+                writel(temp | SHAKTI_SPI_PRESCALE(presc),
+                       spi->base + SHAKTI_SPI_CLK_CTRL_REG);
+        }
+
+        return 0;
+
+clk_err:
+        clk_disable(&spi->clk);
+        return ret;
+}
+
+static int shakti_spi_remove(struct udevice *dev)
+{
+        struct shakti_spi *spi = dev_get_priv(dev);
+        int ret;
+
+        ret = clk_disable(&spi->clk);
+        if (ret < 0)
+                return ret;
+        return 0;
+}
+
+static const struct dm_spi_ops shakti_spi_ops = {
+        .set_mode   = shakti_spi_set_mode,
+        .set_speed  = shakti_spi_set_speed,
+        .xfer       = shakti_spi_xfer,
+};
+
+static const struct udevice_id shakti_spi_ids[] = {
+        { .compatible = "shakti,spi1", },
+        { }
+};
+
+U_BOOT_DRIVER(shakti_spi) = {
+        .name           = "shakti_spi",
+        .id             = UCLASS_SPI,
+        .of_match       = shakti_spi_ids,
+        .ops            = &shakti_spi_ops,
+        .priv_auto      = sizeof(struct shakti_spi),
+        .probe          = shakti_spi_probe,
+        .remove         = shakti_spi_remove,
+};
+
