diff --git a/configs/shakti_defconfig b/configs/shakti_defconfig
new file mode 100644
index 0000000000..4c86ee4c6a
--- /dev/null
+++ b/configs/shakti_defconfig
@@ -0,0 +1,81 @@
+###############################################
+# Shakti Yamuna RV32 Linux RootFS Defconfig
+# Clean + Stable + Fully Working
+###############################################
+
+# Architecture
+BR2_riscv=y
+BR2_RISCV_32=y
+BR2_riscv_custom=y
+BR2_RISCV_ISA_RVI=y
+BR2_RISCV_ISA_RVM=y
+BR2_RISCV_ISA_RVA=y
+BR2_RISCV_ISA_RVC=y
+BR2_RISCV_ABI_ILP32=y
+
+###############################################
+# INTERNAL Buildroot Toolchain (BEST OPTION)
+###############################################
+BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
+BR2_TOOLCHAIN_BUILDROOT_CXX=y
+BR2_TOOLCHAIN_BUILDROOT_LOCALE=y
+BR2_TOOLCHAIN_BUILDROOT_USE_SSP=y
+
+###############################################
+# System Settings
+###############################################
+BR2_TARGET_GENERIC_HOSTNAME="shakti"
+BR2_TARGET_GENERIC_ISSUE="Welcome to Shakti"
+
+# Root password
+BR2_TARGET_GENERIC_PASSWD_SHA512=y
+BR2_TARGET_GENERIC_ROOT_PASSWD="root"
+
+###############################################
+# Serial Console
+###############################################
+BR2_TARGET_GENERIC_GETTY=y
+BR2_TARGET_GENERIC_GETTY_PORT="ttySHK0"
+BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
+BR2_TARGET_GENERIC_GETTY_TERM="linux"
+BR2_TARGET_GENERIC_GETTY_OPTIONS="-n -l /bin/login"
+
+###############################################
+# Init System
+###############################################
+BR2_INIT_BUSYBOX=y
+BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
+
+###############################################
+# Device Management (kernel devtmpfs)
+###############################################
+BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
+
+###############################################
+# Packages (Minimal + Useful)
+###############################################
+BR2_PACKAGE_HTOP=y
+BR2_PACKAGE_MMC_UTILS=y
+BR2_PACKAGE_NANO=y
+BR2_PACKAGE_SUDO=y
+BR2_PACKAGE_SCREEN=y
+BR2_PACKAGE_FILE=y
+BR2_PACKAGE_FTOP=y
+
+###############################################
+# Filesystem Image
+###############################################
+BR2_TARGET_ROOTFS_EXT2=y
+BR2_TARGET_ROOTFS_EXT2_4=y
+BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
+
+# No initramfs for now
+# BR2_TARGET_ROOTFS_CPIO is not set
+
+###############################################
+# Host Tools
+###############################################
+BR2_PACKAGE_HOST_ZIP=y
+BR2_PACKAGE_HOST_ZSTD=y
+BR2_PACKAGE_HOST_ABOOTIMG=y
+
