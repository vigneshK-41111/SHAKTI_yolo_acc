Rule schedule
-------------
Rule: i2c_user_rl_delay_sda
Predicate: True
Blocking rules: (none)
 
Rule: i2c_user_set_i2c_clock
Predicate: i2c_user_mod_start && (! i2c_user_eso)
Blocking rules: (none)
 
Rule: i2c_user_set_scl_clock
Predicate: i2c_user_scl_start && (! i2c_user_eso)
Blocking rules: (none)
 
Rule: i2c_user_count_prescale
Predicate: ! (i2c_user_cprescaler == 8'd0)
Blocking rules: (none)
 
Rule: i2c_user_restore_prescale
Predicate: (i2c_user_cprescaler == 8'd0) && (! (i2c_user_rprescaler == 8'd0))
Blocking rules: (none)
 
Rule: i2c_user_count_scl
Predicate: (! (i2c_user_coSCL == 32'd0)) &&
	   i2c_user_pwI2C.whas && i2c_user_eso &&
	   i2c_user_st_toggle
Blocking rules: (none)
 
Rule: i2c_user_restore_scl
Predicate: (i2c_user_coSCL == 32'd0) && i2c_user_pwI2C.whas &&
	   (! (i2c_user_reSCL == 32'd0))
Blocking rules: (none)
 
Rule: i2c_user_toggle_scl
Predicate: i2c_user_st_toggle && i2c_user_pwSCL.whas
Blocking rules: i2c_user_wait_interrupt
 
Rule: i2c_user_idler
Predicate: i2c_user_mTransFSM == 5'd1
Blocking rules: write_request
 
Rule: i2c_user_check_control_reg
Predicate: i2c_user_configchange && i2c_user_pwI2C.whas && i2c_user_eso &&
	   (! (i2c_user_mTransFSM == 5'd6)) &&
	   (! (i2c_user_mTransFSM == 5'd1)) &&
	   (! (i2c_user_mTransFSM == 5'd12))
Blocking rules: write_request
 
Rule: i2c_user_reset_state
Predicate: (i2c_user_mTransFSM == 5'd9) && i2c_user_pwI2C.whas &&
	   (! i2c_user_ber)
Blocking rules: i2c_user_check_control_reg, read_request, write_request
 
Rule: i2c_user_send_start_trans
Predicate: i2c_user_val_SCL_in && (i2c_user_mTransFSM == 5'd2) &&
	   i2c_user_pwI2C.whas && i2c_user_eso &&
	   i2c_user_bb
Blocking rules: write_request
 
Rule: i2c_user_send_rtstart_trans
Predicate: i2c_user_val_SCL_in && (i2c_user_mTransFSM == 5'd4) &&
	   i2c_user_pwI2C.whas && i2c_user_eso
Blocking rules: i2c_user_check_control_reg, write_request
 
Rule: i2c_user_send_addr
Predicate: i2c_user_mTransFSM == 5'd5
Blocking rules: i2c_user_check_control_reg, write_request
 
Rule: i2c_user_check_Ack
Predicate: (i2c_user_mTransFSM == 5'd11) &&
	   i2c_user_pwSCL.whas && i2c_user_eso
Blocking rules: i2c_user_check_control_reg, write_request
 
Rule: i2c_user_wait_interrupt
Predicate: (i2c_user_mTransFSM == 5'd6) &&
	   i2c_user_pwI2C.whas && i2c_user_eso &&
	   (! i2c_user_val_SCL_in)
Blocking rules: read_request, write_request
 
Rule: i2c_user_send_data
Predicate: (i2c_user_mTransFSM == 5'd7) &&
	   i2c_user_pwSCL.whas && i2c_user_eso && i2c_user_val_SCL
Blocking rules: i2c_user_check_control_reg, write_request
 
Rule: i2c_user_receive_data
Predicate: (i2c_user_mTransFSM == 5'd8) &&
	   i2c_user_pwSCL.whas && i2c_user_eso && (! i2c_user_val_SCL)
Blocking rules: (none)
 
Rule: i2c_user_resetfilter
Predicate: True
Blocking rules: i2c_user_reset_state, i2c_user_idler
 
Rule: i2c_user_receive_data1
Predicate: ((i2c_user_mTransFSM == 5'd8) || (i2c_user_mTransFSM == 5'd3)) &&
	   i2c_user_pwSCL.whas && i2c_user_eso && i2c_user_val_SCL &&
	   ((i2c_user_dataBit == 4'd0) || (i2c_user_dataBit == 4'd8))
Blocking rules: i2c_user_check_control_reg, write_request
 
Rule: i2c_user_wait_interrupt_receive_end
Predicate: (i2c_user_dataBit == 4'd8) && (i2c_user_mTransFSM == 5'd12) &&
	   (! i2c_user_val_SCL_in)
Blocking rules: write_request
 
