Rule: clk_divider_increment_counter
Predicate: ! (clk_divider_rg_divisor == 16'd0)
Blocking rules: (none)
 
Rule: clk_divider_generate_clock
Predicate: True
Blocking rules: (none)
 
Rule: clk_divider_select_clock
Predicate: True
Blocking rules: (none)
 
Rule: gptimer_rl_gpt_reset
Predicate: gptimer_count_reset || gptimer_gpt_reset
Blocking rules: (none)
 
Rule: gptimer_rl_pwm_operation
Predicate: (gptimer_gpt_mode == 2'd0) && gptimer_gpt_enable
Blocking rules: (none)
 
Rule: gptimer_rl_up_counter
Predicate: (gptimer_gpt_mode == 2'd1) && gptimer_gpt_enable
Blocking rules: (none)
 
Rule: gptimer_rl_down_counter
Predicate: (gptimer_gpt_mode == 2'd2) && gptimer_gpt_enable
Blocking rules: (none)
 
Rule: gptimer_rl_up_down_counter
Predicate: (gptimer_gpt_mode == 2'd3) && gptimer_gpt_enable
Blocking rules: (none)
 
Rule: transfer_data_from_clock_domains
Predicate: clock_divisor_sync.RDY_write
Blocking rules: (none)
 
Rule: generate_slow_clock
Predicate: True
Blocking rules: (none)
 
Rule: clk_select
Predicate: True
Blocking rules: (none)
 
Rule: capture_read_request
Predicate: ff_rd_request.RDY_enq && s_xactor_f_rd_addr.i_notEmpty
Blocking rules: (none)
 
Rule: perform_read
Predicate: ff_rd_response.RDY_enq &&
	   ff_rd_request.RDY_deq && ff_rd_request.RDY_first
Blocking rules: (none)
 
Rule: send_read_response
Predicate: ff_rd_response.RDY_deq &&
	   ff_rd_response.RDY_first && s_xactor_f_rd_data.i_notFull
Blocking rules: (none)
 
Rule: capture_write_request
Predicate: ff_wr_request.RDY_enq &&
	   ff_wdata_request.RDY_enq &&
	   s_xactor_f_wr_addr.i_notEmpty && s_xactor_f_wr_data.i_notEmpty
Blocking rules: (none)
 
Rule: perform_write
Predicate: ff_wr_response.RDY_enq &&
	   ff_wr_request.RDY_deq &&
	   ff_wdata_request.RDY_deq &&
	   ff_wr_request.RDY_first && ff_wdata_request.RDY_first
Blocking rules: (none)
 
Rule: send_write_response
Predicate: ff_wr_response.RDY_deq &&
	   ff_wr_response.RDY_first && s_xactor_f_wr_resp.i_notFull
Blocking rules: (none)
 
Rule: syncbits_out
Predicate: True
Blocking rules: (none)
 
Rule: syncbits_in
Predicate: True
Blocking rules: (none)
 
