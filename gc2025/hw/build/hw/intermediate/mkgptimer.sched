Rule: gptimer_rl_update_interrupts
Predicate: True
Blocking rules: (none)
 
Rule: gptimer_rl_update_counter
Predicate: gptimer_rg_sync_counter.RDY_write &&
	   gptimer_rg_sync_repeated_count.RDY_write
Blocking rules: (none)
 
Rule: gptimer_rl_counter_reset
Predicate: gptimer_count_reset.read
Blocking rules: (none)
 
Rule: gptimer_rl_reset_counter_reset
Predicate: gptimer_count_reset.RDY_write && gptimer_sync_count_reset.wget
Blocking rules: write_request
 
Rule: gptimer_rl_pwm_operation
Predicate: (gptimer_gpt_mode.read == 2'd0) && gptimer_gpt_enable.read
Blocking rules: gptimer_rl_counter_reset
 
Rule: gptimer_rl_up_counter
Predicate: (gptimer_gpt_mode.read == 2'd1) && gptimer_gpt_enable.read
Blocking rules: gptimer_rl_counter_reset
 
Rule: gptimer_rl_down_counter
Predicate: (gptimer_gpt_mode.read == 2'd2) && gptimer_gpt_enable.read
Blocking rules: gptimer_rl_counter_reset
 
Rule: gptimer_rl_up_down_counter
Predicate: (gptimer_gpt_mode.read == 2'd3) && gptimer_gpt_enable.read
Blocking rules: gptimer_rl_counter_reset
 
Rule: read_request
Predicate: s_xactor_f_rd_addr.i_notEmpty && s_xactor_f_rd_data.i_notFull
Blocking rules: (none)
 
Rule: write_request
Predicate: s_xactor_f_wr_addr.i_notEmpty &&
	   s_xactor_f_wr_data.i_notEmpty &&
	   s_xactor_f_wr_resp.i_notFull &&
	   gptimer_gpt_enable.RDY_write &&
	   gptimer_gpt_mode.RDY_write &&
	   gptimer_count_reset.RDY_write &&
	   gptimer_continuous_count.RDY_write &&
	   gptimer_pwm_fall_intr_en.RDY_write &&
	   gptimer_pwm_rise_intr_en.RDY_write &&
	   gptimer_cntr_overflow_intr_en.RDY_write &&
	   gptimer_cntr_underflow_intr_en.RDY_write &&
	   gptimer_rg_duty_cycle.RDY_write && gptimer_rg_period.RDY_write
Blocking rules: (none)
 
