    function Bool fn_csrbox_access(Bit#(12) csr_addr, Bit#(5) operand, Bit#(2) operation, Bit#(2) prv);
      Bool write = (operand != 0 || operation=='b01) ? True:False;
      return ((prv >= csr_addr[9:8]) && !(write && csr_addr[11:10]==2'b11) );
    endfunction:fn_csrbox_access


    
    /*doc:func: This function controls if the pipeline should be flushed for
    current csr op being decoded/processed. The control bits are used for
    dynamic control and have the following behavior: 
      - 00 : this is the default behavior where a flush is skipped for : read ops on all csrs that do not have read-side-effects (known at design time), writes on all read-only csrs
      - 01 : in this configuration a flush is skipped for only writes to on read-only csrs
      - 10 : in this configuration a flush is skipped for read-ops on all csrs do not have read-side-effects (known at design time)
      - 11 : a flush is generated for all csr ops.
    */
    function Bool fn_csr_flush(Bit#(12) addr, Bit#(3) op, Bit#(5) rs1, Bit#(2) control);

      Bool read_op = (op[1:0] == 2 || op[1:0] == 3) && rs1 == 0;
      if (control == 'b11) // flush for all read and write ops
        return True;
      else if (control[1] == 1 && !read_op ) // flush on all write ops
        return True;
      else if (control[0] == 1 && read_op) // flush on all read ops
        return True;
      else if (read_op) // do not flush on reads of any csrs
        return False;
      else // do not flush on writes to read-only csrs. Flush for all other writes
        case(addr)
        `MVENDORID , `MARCHID , `MIMPID , `MHARTID , `MCOUNTINHIBIT , `MHPMEVENT3 , `MHPMCOUNTER3 , `MHPMCOUNTER3H , `MHPMEVENT4 , `MHPMCOUNTER4 , `MHPMCOUNTER4H , `MHPMEVENT5 , `MHPMCOUNTER5 , `MHPMCOUNTER5H , `MHPMEVENT6 , `MHPMCOUNTER6 , `MHPMCOUNTER6H , `MHPMEVENT7 , `MHPMCOUNTER7 , `MHPMCOUNTER7H , `MHPMEVENT8 , `MHPMCOUNTER8 , `MHPMCOUNTER8H , `MHPMEVENT9 , `MHPMCOUNTER9 , `MHPMCOUNTER9H , `MHPMEVENT10 , `MHPMCOUNTER10 , `MHPMCOUNTER10H , `MHPMEVENT11 , `MHPMCOUNTER11 , `MHPMCOUNTER11H , `MHPMEVENT12 , `MHPMCOUNTER12 , `MHPMCOUNTER12H , `MHPMEVENT13 , `MHPMCOUNTER13 , `MHPMCOUNTER13H , `MHPMEVENT14 , `MHPMCOUNTER14 , `MHPMCOUNTER14H , `MHPMEVENT15 , `MHPMCOUNTER15 , `MHPMCOUNTER15H , `MHPMEVENT16 , `MHPMCOUNTER16 , `MHPMCOUNTER16H , `MHPMEVENT17 , `MHPMCOUNTER17 , `MHPMCOUNTER17H , `MHPMEVENT18 , `MHPMCOUNTER18 , `MHPMCOUNTER18H , `MHPMEVENT19 , `MHPMCOUNTER19 , `MHPMCOUNTER19H , `MHPMEVENT20 , `MHPMCOUNTER20 , `MHPMCOUNTER20H , `MHPMEVENT21 , `MHPMCOUNTER21 , `MHPMCOUNTER21H , `MHPMEVENT22 , `MHPMCOUNTER22 , `MHPMCOUNTER22H , `MHPMEVENT23 , `MHPMCOUNTER23 , `MHPMCOUNTER23H , `MHPMEVENT24 , `MHPMCOUNTER24 , `MHPMCOUNTER24H , `MHPMEVENT25 , `MHPMCOUNTER25 , `MHPMCOUNTER25H , `MHPMEVENT26 , `MHPMCOUNTER26 , `MHPMCOUNTER26H , `MHPMEVENT27 , `MHPMCOUNTER27 , `MHPMCOUNTER27H , `MHPMEVENT28 , `MHPMCOUNTER28 , `MHPMCOUNTER28H , `MHPMEVENT29 , `MHPMCOUNTER29 , `MHPMCOUNTER29H , `MHPMEVENT30 , `MHPMCOUNTER30 , `MHPMCOUNTER30H , `MHPMEVENT31 , `MHPMCOUNTER31 , `MHPMCOUNTER31H : return False;
